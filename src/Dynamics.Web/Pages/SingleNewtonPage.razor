@page "/singlenewton"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.Newton
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("SingleNewtonIteration") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("SingleNewtonIteration")</h1>

<div class="numeric-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="single-diagram"></canvas>
            <canvas id="single-overlay" class="selectable-point"></canvas>
        </div>
        <p class="hint">@Text.Get("SingleNewtonMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="exponent">n =</label>
            <select id="exponent" disabled="@(!_controller.CanStep)" @onchange="OnExponentChangedAsync">
                @foreach (var n in SingleNewtonController.Exponents)
                {
                    <option value="@n" selected="@(n == _controller.N)">@n</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="ca">@Text.Get("StartPoint")</label>
            <div class="complex-input">
                <span></span>
                <input id="ca" inputmode="double" value="@_controller.A" @oninput="e => _controller.A = Value(e)" />
                <label for="cb">+ i</label>
                <input id="cb" inputmode="double" value="@_controller.B" @oninput="e => _controller.B = Value(e)" />
            </div>
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(!_controller.CanStep)" @onclick="NextStepAsync">@Text.Get("NextStep")</button>
            <button type="button" @onclick="ResetAsync">@Text.Get("Reset")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">@Text.Get("Steps"): <strong>@(Math.Max(0, _controller.Orbit.Count - 1))</strong></p>
    </section>
</div>

@code {
    private const int DiagramSize = 600;

    private static readonly CanvasColor[] RootColors = [CanvasColor.Red, CanvasColor.Blue, CanvasColor.Green];

    private readonly SingleNewtonController _controller = new(DiagramSize);
    private DrawBatch _diagram = null!;
    private DrawBatch _overlay = null!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<SingleNewtonPage>? _selfReference;
    private string? _error;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    protected override void OnInitialized()
    {
        _diagram = new DrawBatch(_controller.Transform);
        _overlay = new DrawBatch(_controller.Transform);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "single-diagram", DiagramSize);
        await _module.InvokeVoidAsync("setup", "single-overlay", DiagramSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "single-overlay", _selfReference);
        DrawCoordinateSystem();
        await DrawOrbitAsync();
    }

    /// <summary>VB: DrawCoordinateSystem: axes, unit roots and the expected borders of the basins (magenta).</summary>
    private void DrawCoordinateSystem()
    {
        var d = _diagram;
        d.Clear();
        d.Line(new MathPoint(0, -1.5), new MathPoint(0, 1.5), CanvasColor.Black, 1);
        d.Line(new MathPoint(-1.5, 0), new MathPoint(1.5, 0), CanvasColor.Black, 1);

        for (var i = 0; i < _controller.UnitRoots.Count; i++)
        {
            d.Point(_controller.UnitRoots[i], RootColors[i], 3);
        }

        var zero = new MathPoint(0, 0);
        if (_controller.N == 2)
        {
            // Separated by the y-axis
            d.Line(new MathPoint(0, -1.5), new MathPoint(0, 1.5), CanvasColor.Magenta, 1);
        }
        else
        {
            // Separated by 120° lines
            var bp = new ComplexNumber(-1.5, 0);
            for (var k = 0; k < 3; k++)
            {
                d.Line(zero, new MathPoint(bp.X, bp.Y), CanvasColor.Magenta, 1);
                bp = bp.Rotate(2 * Math.PI / 3);
            }
        }
    }

    /// <summary>VB: the temporary drawing of IterationStep and IsConvergent.</summary>
    private async Task DrawOrbitAsync()
    {
        var orbit = _controller.Orbit;
        _overlay.Clear();
        for (var i = 0; i < orbit.Count; i++)
        {
            if (i < orbit.Count - 1 || orbit.Count == 1)
            {
                _overlay.Point(orbit[i], CanvasColor.Black, 3);
            }

            if (i > 0)
            {
                _overlay.Line(orbit[i - 1], orbit[i], CanvasColor.Black, 1);
            }
        }

        if (_controller.ConvergedRoot is { } root && orbit.Count > 0)
        {
            _overlay.Point(orbit[^1], RootColors[root], 3);
            _overlay.Point(orbit[0], RootColors[root], 3);
        }

        if (_module is not null)
        {
            if (!_diagram.IsEmpty)
            {
                await _module.InvokeVoidAsync("draw", "single-diagram", _diagram.Take());
            }

            await _module.InvokeVoidAsync("draw", "single-overlay", _overlay.Take());
        }
    }

    private async Task OnExponentChangedAsync(ChangeEventArgs e)
    {
        _controller.LoadRoots(int.Parse(Value(e), CultureInfo.InvariantCulture));
        DrawCoordinateSystem();
        await DrawOrbitAsync();
    }

    private async Task NextStepAsync()
    {
        _error = _controller.NextStep();
        await DrawOrbitAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        await DrawOrbitAsync();
    }

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var point = _controller.Transform.PixelToMathPoint((int)Math.Round(x), (int)Math.Round(y));
        switch (kind)
        {
            case "down":
                _controller.MouseDown(point);
                break;
            case "move":
                if (!_controller.MouseMove(point))
                {
                    return;
                }
                break;
            default:
                _controller.MouseUp();
                return;
        }

        await DrawOrbitAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
