@page "/sensitivity"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.GrowthModel
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("Sensitivity") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("Sensitivity")</h1>

<div class="growth-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="sensitivity-diagram"></canvas>
        </div>
    </section>

    <section class="control-column">
        <div class="field-row">
            <div class="field grow">
                <label for="function">@Text.Get("Function")</label>
                <select id="function" @onchange="OnSystemChangedAsync">
                    @for (var i = 0; i < _names.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="depth">@Text.Get("IterationDepth")</label>
                <select id="depth" @onchange="OnPowerChangedAsync">
                    @for (var power = 1; power <= 12; power++)
                    {
                        <option value="@power" selected="@(power == _controller.Power)">@power</option>
                    }
                </select>
            </div>
        </div>

        <div class="field">
            <label for="parameter">@Text.Get("Parameter") a</label>
            <input id="parameter" inputmode="decimal" value="@_controller.Parameter" @onchange="e => ChangeInputAsync(() => _controller.Parameter = Value(e))" />
        </div>
        <div class="field">
            <label for="start1">@Text.Get("StartValue1")</label>
            <input id="start1" inputmode="decimal" value="@_controller.StartValue1" @onchange="e => ChangeInputAsync(() => _controller.StartValue1 = Value(e))" />
        </div>
        <div class="field">
            <label for="start2">@Text.Get("StartValue2")</label>
            <input id="start2" inputmode="decimal" value="@_controller.StartValue2" @onchange="e => ChangeInputAsync(() => _controller.StartValue2 = Value(e))" />
        </div>

        <fieldset>
            <legend>@Text.Get("Presentation")</legend>
            <div class="radio-row">
                <label class="check">
                    <input type="radio" name="presentation" checked="@_controller.IsDifference" @onchange="() => OnDifferenceAsync(true)" />
                    @Text.Get("Difference12")
                </label>
                <label class="check">
                    <input type="radio" name="presentation" checked="@(!_controller.IsDifference)" @onchange="() => OnDifferenceAsync(false)" />
                    @Text.Get("SingleOrbits")
                </label>
            </div>
            <div class="field">
                <label for="stretching">@Text.Get("xStretching"), @Text.Get("DinStretching")</label>
                <input id="stretching" class="short" inputmode="decimal" value="@_controller.XStretching"
                       @onchange="e => ChangeInputAsync(() => _controller.XStretching = Value(e))" />
            </div>
        </fieldset>

        <div class="buttons">
            <button type="button" class="primary" @onclick="StartAsync">@Text.Get("Start")</button>
            <button type="button" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_message is not null)
        {
            <p class="error" role="alert">@_message</p>
        }

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_controller.N.ToString("N0")</strong></p>
    </section>

    <section class="lists">
        <div>
            <p class="caption">@Text.Get("ValueList1")</p>
            <div class="protocol value-list" role="log">
                @foreach (var value in _controller.ValueList1.TakeLast(DisplayLines).Reverse())
                {
                    <div>@value</div>
                }
            </div>
        </div>
        <div>
            <p class="caption">@Text.Get("ValueList2")</p>
            <div class="protocol value-list" role="log">
                @foreach (var value in _controller.ValueList2.TakeLast(DisplayLines).Reverse())
                {
                    <div>@value</div>
                }
            </div>
        </div>
    </section>
</div>

@code {
    // VB: FrmSensitivity.Designer, PicDiagram 643 x 554; square here like the other diagrams
    private const int DiagramSize = 600;
    private const int DisplayLines = 1000;

    private readonly SensitivityController _controller = new(DiagramSize, DiagramSize);

    private IJSObjectReference? _module;
    private List<string> _names = [];
    private string? _message;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    protected override void OnInitialized() => _names = _controller.Names.ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "sensitivity-diagram", DiagramSize);
    }

    private async Task DrawAsync(DrawBatch batch)
    {
        if (_module is not null && !batch.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "sensitivity-diagram", batch.Take());
        }
    }

    private async Task ClearAsync()
    {
        var batch = new DrawBatch(_controller.Transform);
        batch.Clear();
        await DrawAsync(batch);
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _message = null;
        _controller.SelectSystem(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await ClearAsync();
    }

    private async Task OnPowerChangedAsync(ChangeEventArgs e)
    {
        _controller.SetPower(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await ClearAsync();
    }

    private async Task OnDifferenceAsync(bool isDifference)
    {
        _controller.SetDifference(isDifference);
        await ClearAsync();
    }

    /// <summary>VB: every input (LostFocus) resets the iteration.</summary>
    private async Task ChangeInputAsync(Action set)
    {
        set();
        await ResetAsync();
    }

    private async Task ResetAsync()
    {
        _message = null;
        _controller.ResetIteration();
        await ClearAsync();
    }

    private async Task DefaultAsync()
    {
        _message = null;
        _controller.DefaultUserData();
        await ClearAsync();
    }

    /// <summary>VB: StartIteration draws over the existing picture.</summary>
    private async Task StartAsync()
    {
        var (error, drawing) = _controller.Start();
        _message = error;
        if (drawing is null)
        {
            return;
        }

        var batch = new DrawBatch(_controller.Transform);
        foreach (var line in drawing.Difference)
        {
            batch.Line(line.A, line.B, CanvasColor.Blue, 1);
        }

        foreach (var line in drawing.Orbit1)
        {
            batch.Line(line.A, line.B, CanvasColor.Red, 1);
        }

        foreach (var line in drawing.Orbit2)
        {
            batch.Line(line.A, line.B, CanvasColor.Green, 1);
        }

        await DrawAsync(batch);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
