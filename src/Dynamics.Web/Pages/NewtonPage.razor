@page "/newton"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.Julia
@using Dynamics.Core.Newton
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("NewtonIteration") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("NewtonIteration")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="newton-image" class="pixel-image"></canvas>
            <canvas id="newton-overlay" class="@(_controller.IsAreaSelectable ? "selectable" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("JuliaMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field-row">
            <div class="field grow">
                <label for="function">@Text.Get("NewtonIteration")</label>
                <select id="function" disabled="@(!_controller.IsEditable)" @onchange="OnSystemChangedAsync">
                    @for (var i = 0; i < _names.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                    }
                </select>
            </div>
            @if (_controller.DS.IsUseN)
            {
                <div class="field">
                    <label for="exponent">n =</label>
                    <select id="exponent" disabled="@(!_controller.IsEditable)" @onchange="OnExponentChangedAsync">
                        @foreach (var n in NewtonController.Exponents)
                        {
                            <option value="@n" selected="@(n == _controller.N)">@n</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="ranges">
            <label for="xmin">XMin</label>
            <input id="xmin" inputmode="decimal" value="@_controller.XMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetXMin(Value(e))" />
            <label for="xmax">XMax</label>
            <input id="xmax" inputmode="decimal" value="@_controller.XMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetXMax(Value(e))" />
            <span class="delta">@_controller.DeltaX</span>

            <label for="ymin">YMin</label>
            <input id="ymin" inputmode="decimal" value="@_controller.YMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetYMin(Value(e))" />
            <label for="ymax">YMax</label>
            <input id="ymax" inputmode="decimal" value="@_controller.YMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetYMax(Value(e))" />
            <span class="delta">@_controller.DeltaY</span>
        </div>

        @if (_controller.DS.IsUseC)
        {
            <div class="complex-input">
                <label for="ca">c =</label>
                <input id="ca" inputmode="decimal" value="@_controller.A" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetA(Value(e))" />
                <label for="cb">+ i</label>
                <input id="cb" inputmode="decimal" value="@_controller.B" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetB(Value(e))" />
            </div>
        }

        <div class="option-groups">
            <fieldset>
                <legend>@Text.Get("Mixing")</legend>
                @foreach (var mixing in Enum.GetValues<NewtonMixing>())
                {
                    <label class="check">
                        <input type="radio" name="mixing" checked="@(_controller.Mixing == mixing)" disabled="@(!_controller.IsEditable)"
                               @onchange="() => _controller.SetMixing(mixing)" />
                        @Text.Get(mixing.ToString())
                    </label>
                }
            </fieldset>
            <fieldset>
                <legend>@Text.Get("Color")</legend>
                <label class="check">
                    <input type="radio" name="color" checked="@(_controller.Color == NewtonColor.Bright)" disabled="@(!_controller.IsEditable)"
                           @onchange="() => _controller.Color = NewtonColor.Bright" />
                    @Text.Get("Bright")
                </label>
                <label class="check">
                    <input type="radio" name="color" checked="@(_controller.Color == NewtonColor.Shadowed)" disabled="@(!_controller.IsEditable)"
                           @onchange="() => _controller.Color = NewtonColor.Shadowed" />
                    @Text.Get("Shaded")
                </label>
            </fieldset>
        </div>

        <label class="check">
            <input type="checkbox" checked="@_controller.IsProtocol" disabled="@(!_controller.IsEditable)"
                   @onchange="e => _controller.IsProtocol = e.Value is true" />
            @Text.Get("Protocol")
        </label>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Stopped ? Text.Get("Start") : Text.Get("Continue"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
            @if (_controller.DS.IsShowBasin)
            {
                <button type="button" disabled="@(!_controller.IsEditable)" @onclick="ShowBasinAsync">@Text.Get("ShowBasin")</button>
            }
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">
            @Text.Get("Steps"): <strong>@_controller.Steps.ToString("N0")</strong>
            &nbsp; @Text.Get("Time"): <strong>@_controller.Elapsed.TotalSeconds.ToString("F2") s</strong>
        </p>

        <p class="caption">@Text.Get("ProtocolNewton")</p>
        <div class="protocol julia-protocol" role="log">
            @foreach (var line in _controller.Protocol.TakeLast(DisplayLines).Reverse())
            {
                <div>@line</div>
            }
        </div>
    </section>
</div>

@code {
    private const int DiagramSize = 600;
    private const int DisplayLines = 200;
    private const double FrameBudgetMs = 15;

    private readonly NewtonController _controller = new(DiagramSize);
    private readonly PixelImage _image = new(DiagramSize);

    /// <summary>Temporary drawing over the picture (VB: on the picture box): selection rectangle, basin.</summary>
    private DrawBatch _overlay = null!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<NewtonPage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private bool _disposed;
    private (int X, int Y)? _selectionStart;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static int IntValue(ChangeEventArgs e) => int.Parse(Value(e), CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        _names = _controller.NewtonNames.ToList();
        _overlay = new DrawBatch(new CoordinateTransform(DiagramSize, DiagramSize, NewtonBasin.XInterval, NewtonBasin.YInterval));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "newton-image", DiagramSize, true);
        await _module.InvokeVoidAsync("setup", "newton-overlay", DiagramSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "newton-overlay", _selfReference);
        await PrepareAsync();
    }

    /// <summary>VB: ResetIteration of the model, clear the bitmap, draw the coordinate system and the roots.</summary>
    private async Task PrepareAsync()
    {
        _image.Clear();
        _image.DrawAxes(_controller.DS.Transform);
        DrawRoots(finished: false);
        _overlay.Clear();
        await FlushAsync();
    }

    /// <summary>VB: DrawRoots; black when the picture is finished.</summary>
    private void DrawRoots(bool finished)
    {
        foreach (var root in _controller.DS.Roots)
        {
            _image.FillCircle(_controller.DS.Transform, new MathPoint((decimal)root.X, (decimal)root.Y), 3,
                finished ? Argb.Black : root.GetColor(1));
        }
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _image.FlushAsync(_module, "newton-image");
        if (!_overlay.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "newton-overlay", _overlay.Take());
        }
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectSystem(IntValue(e));
        await PrepareAsync();
    }

    private async Task OnExponentChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SetExponent(IntValue(e));
        await PrepareAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        await PrepareAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.DefaultUserData();
        await PrepareAsync();
    }

    /// <summary>VB: ShowBasin draws the approximated basin (1) temporarily over the reset picture.</summary>
    private async Task ShowBasinAsync()
    {
        _error = null;
        var basin = _controller.ShowBasin();
        await PrepareAsync();

        var b = _overlay;
        b.Clear();
        b.Line(new MathPoint(NewtonBasin.XInterval.A, 0), new MathPoint(NewtonBasin.XInterval.B, 0), CanvasColor.Black, 1);
        b.Line(new MathPoint(0, NewtonBasin.YInterval.A), new MathPoint(0, NewtonBasin.YInterval.B), CanvasColor.Black, 1);
        b.Circle(new MathPoint(1, 0), 1, CanvasColor.Blue, 1);
        b.Circle(new MathPoint(1, 0), basin.InnerRadius, CanvasColor.Green, 1);
        b.Point(new MathPoint(1, 0), CanvasColor.Black, 2);
        b.Line(new MathPoint(0, 0), basin.Asymptote, CanvasColor.Green, 1);
        b.Line(new MathPoint(0, 0), new MathPoint(basin.Asymptote.X, -basin.Asymptote.Y), CanvasColor.Green, 1);
        foreach (var point in basin.CurvePoints)
        {
            b.Point(point, CanvasColor.Red, 1);
        }

        await FlushAsync();
    }

    private async Task StartAsync()
    {
        var wasStopped = _controller.Status == IterationStatus.Stopped;
        _error = _controller.Start();
        if (_error is not null)
        {
            return;
        }

        if (wasStopped)
        {
            await PrepareAsync();
        }

        var watch = new System.Diagnostics.Stopwatch();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            watch.Restart();
            while (watch.Elapsed.TotalMilliseconds < FrameBudgetMs && _controller.Step(out var step))
            {
                _image.Set(step.P, step.Q, step.Pixel.Color);
            }

            if (_controller.IsFinished)
            {
                DrawRoots(finished: true);
            }

            await FlushAsync();
            StateHasChanged();

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        // Interrupted: VB draws the roots black as well
        if (_controller.IsFinished)
        {
            DrawRoots(finished: true);
            await FlushAsync();
        }

        StateHasChanged();
    }

    private static (int X, int Y) BitmapPixel(double x, double y) => (
        Math.Clamp((int)Math.Floor(x), 0, DiagramSize - 1),
        Math.Clamp((int)Math.Floor(y), 0, DiagramSize - 1));

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var point = BitmapPixel(x, y);
        switch (kind)
        {
            case "down":
                if (_controller.IsAreaSelectable)
                {
                    _selectionStart = point;
                }
                break;
            case "move":
                if (_selectionStart is { } start)
                {
                    _overlay.Clear();
                    _overlay.PixelRectangle(Math.Min(start.X, point.X), Math.Min(start.Y, point.Y),
                        Math.Abs(start.X - point.X) + 1, Math.Abs(start.Y - point.Y) + 1, CanvasColor.Red, 2);
                    await FlushAsync();
                }
                break;
            default:
                if (_selectionStart is { } begin)
                {
                    _selectionStart = null;
                    _overlay.Clear();
                    await FlushAsync();
                    var (p1, q1) = SpiralScan.PixelAt(begin.X, begin.Y);
                    var (p2, q2) = SpiralScan.PixelAt(point.X, point.Y);
                    if (_controller.SelectArea(p1, q1, p2, q2))
                    {
                        StateHasChanged();
                    }
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _controller.Stop();
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
