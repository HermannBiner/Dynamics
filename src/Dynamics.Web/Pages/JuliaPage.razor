@page "/julia"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.Julia
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("JuliaMandelbrot") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("JuliaMandelbrot")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="julia-image" class="pixel-image"></canvas>
            <canvas id="julia-overlay" class="@(_controller.IsAreaSelectable ? "selectable" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("JuliaMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field-row">
            <div class="field grow">
                <label for="function">@Text.Get("JuliaMandelbrot")</label>
                <select id="function" disabled="@(!_controller.IsEditable)" @onchange="OnSystemChangedAsync">
                    @for (var i = 0; i < _juliaNames.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedIndex)">@_juliaNames[i]</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="exponent">n =</label>
                <select id="exponent" disabled="@(!_controller.IsEditable)" @onchange="OnExponentChangedAsync">
                    @foreach (var n in JuliaController.Exponents)
                    {
                        <option value="@n" selected="@(n == _controller.N)">@n</option>
                    }
                </select>
            </div>
        </div>

        @if (!_controller.DS.IsMandelbrot)
        {
            <div class="field">
                <label for="samples">@Text.Get("Samples")</label>
                <select id="samples" disabled="@(!_controller.IsEditable)" @onchange="OnSampleChanged">
                    @for (var i = 0; i < _controller.Samples.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedSample)">@_controller.Samples[i].Name</option>
                    }
                </select>
            </div>
        }

        <div class="ranges">
            <label for="xmin">XMin</label>
            <input id="xmin" inputmode="double" value="@_controller.XMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetXMin(Value(e))" />
            <label for="xmax">XMax</label>
            <input id="xmax" inputmode="double" value="@_controller.XMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetXMax(Value(e))" />
            <span class="delta">@_controller.DeltaX</span>

            <label for="ymin">YMin</label>
            <input id="ymin" inputmode="double" value="@_controller.YMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetYMin(Value(e))" />
            <label for="ymax">YMax</label>
            <input id="ymax" inputmode="double" value="@_controller.YMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetYMax(Value(e))" />
            <span class="delta">@_controller.DeltaY</span>
        </div>

        <div class="complex-input">
            <label for="ca">c =</label>
            <input id="ca" inputmode="double" value="@_controller.A" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.A = Value(e)" />
            <label for="cb">+ i</label>
            <input id="cb" inputmode="double" value="@_controller.B" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.B = Value(e)" />
        </div>

        <fieldset>
            <legend>@Text.Get("Colors")</legend>
            <label class="check">
                <input type="radio" name="colors" checked="@_controller.IsSystemColors" disabled="@(!_controller.IsEditable)"
                       @onchange="() => OnColorModeChangedAsync(true)" />
                @Text.Get("System")
            </label>
            <label class="check">
                <input type="radio" name="colors" checked="@(!_controller.IsSystemColors)" disabled="@(!_controller.IsEditable)"
                       @onchange="() => OnColorModeChangedAsync(false)" />
                @Text.Get("UserDefined")
            </label>
            @if (!_controller.IsSystemColors)
            {
                <div class="color-sliders">
                    <input type="range" class="red" min="0" max="10" value="@_controller.Red" disabled="@(!_controller.IsEditable)" aria-label="Red"
                           @oninput="e => _controller.SetUserColors(IntValue(e), _controller.Green, _controller.Blue)" />
                    <input type="range" class="green" min="0" max="10" value="@_controller.Green" disabled="@(!_controller.IsEditable)" aria-label="Green"
                           @oninput="e => _controller.SetUserColors(_controller.Red, IntValue(e), _controller.Blue)" />
                    <input type="range" class="blue" min="0" max="10" value="@_controller.Blue" disabled="@(!_controller.IsEditable)" aria-label="Blue"
                           @oninput="e => _controller.SetUserColors(_controller.Red, _controller.Green, IntValue(e))" />
                    <div class="swatches">
                        <span style="background:@Css(_controller.PreviewColor(255))"></span>
                        <span style="background:@Css(_controller.PreviewColor(150))"></span>
                    </div>
                </div>
            }
        </fieldset>

        <label class="check">
            <input type="checkbox" checked="@_controller.IsProtocol" disabled="@(!_controller.IsEditable)"
                   @onchange="e => _controller.IsProtocol = e.Value is true" />
            @Text.Get("Protocol")
        </label>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Stopped ? Text.Get("Start") : Text.Get("Continue"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">
            @Text.Get("Steps"): <strong>@_controller.Steps.ToString("N0")</strong>
            &nbsp; @Text.Get("Time"): <strong>@_controller.Elapsed.TotalSeconds.ToString("F2") s</strong>
        </p>

        <p class="caption">@Text.Get("ProtocolJulia")</p>
        <div class="protocol julia-protocol" role="log">
            @foreach (var line in _controller.Protocol.AsEnumerable().Reverse())
            {
                <div>@line</div>
            }
        </div>
    </section>
</div>

@code {
    private const int DiagramSize = 600;
    private const double FrameBudgetMs = 15;

    private readonly JuliaController _controller = new(DiagramSize);
    private readonly PixelImage _image = new(DiagramSize);
    private DrawBatch _overlay = null!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<JuliaPage>? _selfReference;
    private List<string> _juliaNames = [];
    private string? _error;
    private bool _disposed;

    // Area selection with the mouse (VB: ClsDiagramAreaSelector)
    private (int X, int Y)? _selectionStart;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static int IntValue(ChangeEventArgs e) => int.Parse(Value(e), CultureInfo.InvariantCulture);
    private static string Css(int argb) => $"rgb({Argb.Red(argb)},{Argb.Green(argb)},{Argb.Blue(argb)})";

    protected override void OnInitialized()
    {
        _juliaNames = _controller.JuliaNames.ToList();
        _overlay = new DrawBatch(_controller.DS.Transform);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "julia-image", DiagramSize, true);
        await _module.InvokeVoidAsync("setup", "julia-overlay", DiagramSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "julia-overlay", _selfReference);
        await PrepareAsync();
    }

    /// <summary>VB: ResetIteration of the model, clear the bitmap and draw the coordinate system.</summary>
    private async Task PrepareAsync()
    {
        _image.Clear();
        _image.DrawAxes(_controller.DS.Transform);
        _overlay.Clear();
        await FlushAsync();
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _image.FlushAsync(_module, "julia-image");
        if (!_overlay.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "julia-overlay", _overlay.Take());
        }
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectSystem(IntValue(e));
        await PrepareAsync();
    }

    private async Task OnExponentChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SetExponent(IntValue(e));
        await PrepareAsync();
    }

    private void OnSampleChanged(ChangeEventArgs e) => _controller.SetSample(IntValue(e));

    private async Task OnColorModeChangedAsync(bool isSystemColors)
    {
        _controller.SetColorMode(isSystemColors);
        await PrepareAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        await PrepareAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.DefaultUserData();
        await PrepareAsync();
    }

    private async Task StartAsync()
    {
        var wasStopped = _controller.Status == IterationStatus.Stopped;
        _error = _controller.Start();
        if (_error is not null)
        {
            return;
        }

        if (wasStopped)
        {
            // New ranges: clear the picture and draw the coordinate system
            await PrepareAsync();
        }

        var watch = new System.Diagnostics.Stopwatch();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            watch.Restart();
            while (watch.Elapsed.TotalMilliseconds < FrameBudgetMs && _controller.Step(out var step))
            {
                _image.Set(step.P, step.Q, step.Pixel.Color);
            }

            await FlushAsync();
            StateHasChanged();

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        StateHasChanged();
    }

    /// <summary>The bitmap pixel under the mouse (logical canvas coordinates), inside the diagram.</summary>
    private static (int X, int Y) BitmapPixel(double x, double y) => (
        Math.Clamp((int)Math.Floor(x), 0, DiagramSize - 1),
        Math.Clamp((int)Math.Floor(y), 0, DiagramSize - 1));

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var point = BitmapPixel(x, y);
        switch (kind)
        {
            case "down":
                if (_controller.IsAreaSelectable)
                {
                    _selectionStart = point;
                }
                break;
            case "move":
                if (_selectionStart is { } start)
                {
                    // The rectangle encloses the start and end pixels
                    _overlay.Clear();
                    _overlay.PixelRectangle(Math.Min(start.X, point.X), Math.Min(start.Y, point.Y),
                        Math.Abs(start.X - point.X) + 1, Math.Abs(start.Y - point.Y) + 1, CanvasColor.Red, 2);
                    await FlushAsync();
                }
                break;
            default:
                if (_selectionStart is { } begin)
                {
                    _selectionStart = null;
                    _overlay.Clear();
                    await FlushAsync();
                    var (p1, q1) = SpiralScan.PixelAt(begin.X, begin.Y);
                    var (p2, q2) = SpiralScan.PixelAt(point.X, point.Y);
                    if (_controller.SelectArea(p1, q1, p2, q2))
                    {
                        StateHasChanged();
                    }
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _controller.Stop();
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
