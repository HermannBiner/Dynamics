@page "/bifurcation"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.StrangeAttractor
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("Bifurcation") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("Bifurcation")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="bifurcation-diagram"></canvas>
            <canvas id="bifurcation-overlay" class="@(_controller.IsEditable ? "selectable" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("JuliaMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="system">@Text.Get("StrangeAttractor")</label>
            <select id="system" disabled="@(!_controller.IsEditable)" @onchange="OnSystemChangedAsync">
                @for (var i = 0; i < _names.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                }
            </select>
        </div>

        <fieldset>
            <legend>@Text.Get("Coordinate")</legend>
            <div class="radio-row">
                @foreach (var coordinate in Enum.GetValues<AttractorCoordinate>())
                {
                    <label class="check">
                        <input type="radio" name="coordinate" checked="@(_controller.Coordinate == coordinate)" disabled="@(!_controller.IsEditable)"
                               @onchange="() => _controller.SetActualValueRange(coordinate)" />
                        @coordinate
                    </label>
                }
            </div>
        </fieldset>

        <p class="caption">@Text.Get("ExaminatedParameterRange")</p>
        <div class="ranges">
            <label for="amin">@(_controller.DS.DSParameter.Name)Min</label>
            <input id="amin" inputmode="decimal" value="@_controller.AMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetAMin(Value(e))" />
            <label for="amax">@(_controller.DS.DSParameter.Name)Max</label>
            <input id="amax" inputmode="decimal" value="@_controller.AMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetAMax(Value(e))" />
            <span class="delta">@_controller.DeltaA</span>
        </div>

        <p class="caption">@Text.Get("ExaminatedValueRange")</p>
        <div class="ranges">
            <label for="xmin">@(_controller.ValueParameter.Name)Min</label>
            <input id="xmin" inputmode="decimal" value="@_controller.XMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetXMin(Value(e))" />
            <label for="xmax">@(_controller.ValueParameter.Name)Max</label>
            <input id="xmax" inputmode="decimal" value="@_controller.XMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetXMax(Value(e))" />
            <span class="delta">@_controller.DeltaX</span>
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(!_controller.IsEditable)" @onclick="StartAsync">@Text.Get("Start")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">
            @_controller.Columns / @DiagramSize
            &nbsp; @Text.Get("Time"): <strong>@_watch.Elapsed.TotalSeconds.ToString("F1") s</strong>
        </p>
    </section>
</div>

@code {
    // VB: FrmBifurcation.Designer, PicDiagram 580 x 580 (one column of the diagram per pixel)
    private const int DiagramSize = 580;
    private const double FrameBudgetMs = 15;

    private readonly BifurcationController _controller = new(DiagramSize, DiagramSize);
    private readonly System.Diagnostics.Stopwatch _watch = new();
    private DrawBatch _overlay = new(new CoordinateTransform(DiagramSize, DiagramSize, new Interval(0m, 1m), new Interval(0m, 1m)));

    private IJSObjectReference? _module;
    private DotNetObjectReference<BifurcationPage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private bool _disposed;
    private (int X, int Y)? _selectionStart;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    protected override void OnInitialized() => _names = _controller.AttractorNames.ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "bifurcation-diagram", DiagramSize);
        await _module.InvokeVoidAsync("setup", "bifurcation-overlay", DiagramSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "bifurcation-overlay", _selfReference);
    }

    private async Task DrawAsync(DrawBatch batch, string canvas)
    {
        if (_module is not null && !batch.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", canvas, batch.Take());
        }
    }

    /// <summary>VB: ResetIteration clears the picture.</summary>
    private async Task ClearAsync()
    {
        var diagram = new DrawBatch(_controller.Transform);
        diagram.Clear();
        await DrawAsync(diagram, "bifurcation-diagram");
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectSystem(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await ClearAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        _watch.Reset();
        await ClearAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.DefaultUserData();
        _watch.Reset();
        await ClearAsync();
    }

    private async Task StartAsync()
    {
        _error = _controller.Start();
        await ClearAsync();
        if (_error is not null)
        {
            return;
        }

        var diagram = new DrawBatch(_controller.Transform);
        var watch = new System.Diagnostics.Stopwatch();
        _watch.Restart();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            watch.Restart();
            while (watch.Elapsed.TotalMilliseconds < FrameBudgetMs && _controller.NextColumn() is { } column)
            {
                foreach (var (color, values) in column.Cycles)
                {
                    foreach (var value in values)
                    {
                        diagram.Point(new MathPoint(column.ParameterValue, _controller.ClampToValueRange(value)), color, 1);
                    }
                }
            }

            if (_controller.Status == IterationStatus.Stopped)
            {
                // VB: DrawSplitPoints
                foreach (var (value, isLast) in _controller.SplitLines())
                {
                    diagram.VerticalLine(value, isLast ? CanvasColor.Red : CanvasColor.Green, 1);
                }
            }

            await DrawAsync(diagram, "bifurcation-diagram");
            StateHasChanged();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        _watch.Stop();
        StateHasChanged();
    }

    private static (int X, int Y) Pixel(double x, double y) => (
        Math.Clamp((int)Math.Round(x), 1, DiagramSize),
        Math.Clamp((int)Math.Round(y), 1, DiagramSize));

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var point = Pixel(x, y);
        switch (kind)
        {
            case "down":
                if (_controller.IsEditable)
                {
                    _selectionStart = point;
                }
                break;
            case "move":
                if (_selectionStart is { } start)
                {
                    _overlay.Clear();
                    _overlay.PixelRectangle(Math.Min(start.X, point.X), Math.Min(start.Y, point.Y),
                        Math.Abs(start.X - point.X), Math.Abs(start.Y - point.Y), CanvasColor.Red, 2);
                    await DrawAsync(_overlay, "bifurcation-overlay");
                }
                break;
            default:
                if (_selectionStart is { } begin)
                {
                    _selectionStart = null;
                    _overlay.Clear();
                    await DrawAsync(_overlay, "bifurcation-overlay");
                    if (_controller.SelectArea(begin.X, begin.Y, point.X, point.Y))
                    {
                        StateHasChanged();
                    }
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
