@page "/twodimensions"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.GrowthModel
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("TwoDimensions") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("TwoDimensions")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="twodim-raster"></canvas>
            <canvas id="twodim-orbit"></canvas>
            <canvas id="twodim-overlay" class="@(CanMark ? "selectable-point" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("TwoDimensionsMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="function">@Text.Get("Function")</label>
            <select id="function" disabled="@(!_controller.IsEditable)" @onchange="OnSystemChangedAsync">
                @for (var i = 0; i < _names.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                }
            </select>
        </div>

        <fieldset>
            <legend>@Text.Get("Function")</legend>
            <div class="radio-row">
                <label class="check">
                    <input type="radio" name="mode" checked="@(_controller.Mode == TwoDimensionsMode.Sensitivity)" disabled="@(!_controller.IsEditable)"
                           @onchange="() => OnModeAsync(TwoDimensionsMode.Sensitivity)" />
                    @Text.Get("Sensitivity")
                </label>
                <label class="check">
                    <input type="radio" name="mode" checked="@(_controller.Mode == TwoDimensionsMode.Transitivity)" disabled="@(!_controller.IsEditable)"
                           @onchange="() => OnModeAsync(TwoDimensionsMode.Transitivity)" />
                    @Text.Get("Transitivity")
                </label>
            </div>
        </fieldset>

        <div class="field">
            <label for="parameter">@Text.Get("Parameter") a</label>
            <input id="parameter" inputmode="decimal" value="@_controller.Parameter" disabled="@(!_controller.IsEditable)"
                   @onchange="e => _controller.Parameter = Value(e)" />
        </div>

        <p class="caption">@Text.Get("CoordinatesStartpoint")</p>
        <div class="field-row">
            <div class="field grow">
                <label for="x">x</label>
                <input id="x" inputmode="decimal" value="@_controller.X" disabled="@(!_controller.IsEditable)" @onchange="e => _controller.X = Value(e)" />
            </div>
            <div class="field grow">
                <label for="y">y</label>
                <input id="y" inputmode="decimal" value="@_controller.Y" disabled="@(!_controller.IsEditable)" @onchange="e => _controller.Y = Value(e)" />
            </div>
        </div>

        @if (_controller.Mode == TwoDimensionsMode.Sensitivity)
        {
            <div class="field">
                <label for="experiment">@Text.Get("ExperimentNo")</label>
                <div class="field-row">
                    <select id="experiment" class="grow" disabled="@(!_controller.IsEditable)"
                            @onchange="e => _controller.SetExperiment(int.Parse(Value(e), CultureInfo.InvariantCulture))">
                        @for (var i = 0; i < TwoDimensionsController.ExperimentColors.Length; i++)
                        {
                            <option value="@i" selected="@(i == _controller.Experiment)">Experiment @(i + 1)</option>
                        }
                    </select>
                    <span class="swatch" style="background:@Css(_controller.Color)"></span>
                </div>
            </div>
        }

        <div class="buttons">
            @if (_controller.Mode == TwoDimensionsMode.Sensitivity)
            {
                <button type="button" class="primary" disabled="@(!_controller.IsEditable)" @onclick="() => IterateAsync(1)">@Text.Get("NextStep")</button>
                <button type="button" disabled="@(!_controller.IsEditable)" @onclick="() => IterateAsync(10)">@Text.Get("Next10Steps")</button>
            }
            else
            {
                <button type="button" class="primary" disabled="@(!_controller.IsEditable)" @onclick="() => IterateAsync(1)">@Text.Get("Start")</button>
                <button type="button" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            }
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_steps.ToString("N0")</strong></p>
    </section>
</div>

@code {
    // VB: FrmTwoDimensions.Designer, PicDiagram 600 x 600
    private const int DiagramSize = 600;

    // VB: Color.Aqua
    private static readonly int Aqua = unchecked((int)0xFF00FFFF);

    private readonly TwoDimensionsController _controller = new(DiagramSize);

    private IJSObjectReference? _module;
    private DotNetObjectReference<TwoDimensionsPage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private bool _disposed;
    private int _steps;

    private bool CanMark => _controller.IsEditable && !_controller.IsTargetCellMarked;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    private static string Css(int argb) => $"rgb({(argb >> 16) & 255},{(argb >> 8) & 255},{argb & 255})";

    protected override void OnInitialized() => _names = _controller.Names.ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        foreach (var canvas in new[] { "twodim-raster", "twodim-orbit", "twodim-overlay" })
        {
            await _module.InvokeVoidAsync("setup", canvas, DiagramSize);
        }

        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "twodim-overlay", _selfReference);
        await PrepareDiagramAsync();
    }

    private async Task DrawAsync(DrawBatch batch, string canvas)
    {
        if (_module is not null && !batch.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", canvas, batch.Take());
        }
    }

    private void FillCell(DrawBatch batch, MathPoint corner, int argb) =>
        batch.FillRectangle(corner, new MathPoint(corner.X + _controller.DeltaX, corner.Y + _controller.DeltaX), argb);

    /// <summary>VB: PrepareDiagram (raster of 5 × 5 pixels) with the marked cells; clears the orbits.</summary>
    private async Task PrepareDiagramAsync()
    {
        var range = _controller.DS.ValueParameter.Range;
        var raster = new DrawBatch(_controller.Transform);
        raster.Clear();
        foreach (var u in _controller.RasterLines())
        {
            raster.Line(new MathPoint(u, range.A), new MathPoint(u, range.B), Aqua, 1);
            raster.Line(new MathPoint(range.A, u), new MathPoint(range.B, u), Aqua, 1);
        }

        foreach (var cell in _controller.Cells)
        {
            FillCell(raster, cell.Corner, cell.Color);
        }

        await DrawAsync(raster, "twodim-raster");

        var orbit = new DrawBatch(_controller.Transform);
        orbit.Clear();
        await DrawAsync(orbit, "twodim-orbit");
        await DrawOverlayAsync();
    }

    private async Task DrawOverlayAsync()
    {
        var overlay = new DrawBatch(_controller.Transform);
        overlay.Clear();
        if (_controller.HoverCell is { } hover)
        {
            FillCell(overlay, hover.Corner, hover.Color);
        }

        await DrawAsync(overlay, "twodim-overlay");
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _steps = 0;
        _controller.SelectSystem(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await PrepareDiagramAsync();
    }

    private async Task OnModeAsync(TwoDimensionsMode mode)
    {
        _error = null;
        _steps = 0;
        _controller.SetMode(mode);
        await PrepareDiagramAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _steps = 0;
        _controller.ResetIteration();
        await PrepareDiagramAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _steps = 0;
        _controller.DefaultUserData();
        await PrepareDiagramAsync();
    }

    /// <summary>VB: StartIteration, one step per frame (VB waited 2 ms per step).</summary>
    private async Task IterateAsync(int endOfLoop)
    {
        _error = _controller.Begin(endOfLoop);
        if (_controller.Status != IterationStatus.Running)
        {
            return;
        }

        var color = _controller.Color;
        var orbit = new DrawBatch(_controller.Transform);
        var start = _controller.StartPoint;
        orbit.Point(start, color, 2);
        orbit.PixelCircle(start, 5, color, 1);
        await DrawAsync(orbit, "twodim-orbit");

        while (!_disposed && _controller.Step() is { } step)
        {
            _steps++;
            orbit.Point(step.NextP, color, 1);
            orbit.Line(step.P, step.NextP, color, 1);
            if (step.TargetCell is { } target)
            {
                FillCell(orbit, target, TwoDimensionsController.Red);
            }

            await DrawAsync(orbit, "twodim-orbit");
            StateHasChanged();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        x = Math.Clamp(x, 0, DiagramSize);
        y = Math.Clamp(y, 0, DiagramSize);
        switch (kind)
        {
            case "down":
                _controller.MouseDown(x, y);
                await DrawOverlayAsync();
                break;
            case "move":
                _controller.MouseMove(x, y);
                await DrawOverlayAsync();
                break;
            default:
                var hadCell = _controller.Cells.Count;
                _error = _controller.MouseUp();
                await DrawOverlayAsync();
                if (_controller.Cells.Count != hadCell)
                {
                    var raster = new DrawBatch(_controller.Transform);
                    var cell = _controller.Cells[^1];
                    FillCell(raster, cell.Corner, cell.Color);
                    await DrawAsync(raster, "twodim-raster");
                }

                StateHasChanged();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
