@page "/strangeattractor"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.StrangeAttractor
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("StrangeAttractor") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("StrangeAttractor")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="attractor-diagram"></canvas>
            <canvas id="attractor-overlay" class="@(_controller.CanRotate ? "rotatable" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("StrangeAttractorMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field-row">
            <div class="field grow">
                <label for="attractor">@Text.Get("StrangeAttractor")</label>
                <select id="attractor" disabled="@(!IsStopped)" @onchange="OnSystemChangedAsync">
                    @for (var i = 0; i < _names.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                    }
                </select>
            </div>
            <div class="field grow">
                <label for="pointsets">@Text.Get("StartpointSets")</label>
                <select id="pointsets" disabled="@(!IsStopped)" @onchange="OnPointSetChanged">
                    @for (var i = 0; i < _controller.DS.StartPointSets.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedPointSet)">@_controller.DS.StartPointSets[i].Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="field">
            <label for="dsparameter">@_controller.DS.DSParameter.Name = @_controller.DSParameterText</label>
            <input id="dsparameter" type="range" min="0" max="@StrangeAttractorController.DSParameterTrackBarMaximum"
                   value="@_controller.DSParameterTrackBar" disabled="@(!IsStopped)" @oninput="OnDSParameterChangedAsync" />
        </div>

        <div class="field">
            <label for="stepwidth">@_controller.StepWidthText</label>
            <input id="stepwidth" type="range" min="1" max="@StrangeAttractorController.StepWidths.Count"
                   value="@_controller.StepWidthTrackBar" disabled="@(!IsStopped)"
                   @oninput="e => _controller.SetStepWidthFromTrackBar(IntValue(e))" />
        </div>

        <fieldset>
            <legend>@Text.Get("StartPointCoordinates")</legend>
            <div class="parameters">
                <label for="sx">X</label>
                <input id="sx" inputmode="double" value="@_controller.X" disabled="@(!_controller.IsStartPointEditable)" @oninput="e => _controller.X = Value(e)" />
                <label for="sy">Y</label>
                <input id="sy" inputmode="double" value="@_controller.Y" disabled="@(!_controller.IsStartPointEditable)" @oninput="e => _controller.Y = Value(e)" />
                <label for="sz">Z</label>
                <input id="sz" inputmode="double" value="@_controller.Z" disabled="@(!_controller.IsStartPointEditable)" @oninput="e => _controller.Z = Value(e)" />
            </div>
            <button type="button" disabled="@(!_controller.CanTakeOver)" @onclick="TakeOverAsync">@Text.Get("TakeOverPointSet")</button>
        </fieldset>

        <fieldset>
            <legend>@Text.Get("Projection")</legend>
            <div class="radio-row">
                @foreach (var projection in Enum.GetValues<AttractorProjection>())
                {
                    <label class="check">
                        <input type="radio" name="projection" checked="@(_controller.Projection == projection)"
                               disabled="@(_controller.Status == IterationStatus.Running)" @onchange="() => OnProjectionChangedAsync(projection)" />
                        @(projection == AttractorProjection.ThreeD ? "3D" : projection.ToString())
                    </label>
                }
            </div>
            @if (_controller.Projection == AttractorProjection.ThreeD)
            {
                <p class="steps">φ = @_controller.PhiText &nbsp; θ = @_controller.ThetaText</p>
            }
        </fieldset>

        <div class="field">
            <label for="speed">@Text.Get("AnimationSpeed"): @SpeedLabel</label>
            <input id="speed" type="range" min="0" max="@(StepsPerSecond.Length - 1)" value="@_speedIndex"
                   @oninput="e => _speedIndex = IntValue(e)" />
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(!CanPressStart)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Stopped ? Text.Get("Start") : Text.Get("Continue"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_controller.N.ToString("N0")</strong></p>
    </section>
</div>

@code {
    private const int DiagramSize = 600;
    private const double FrameBudgetMs = 12;

    /// <summary>Passes per second (one pass = one step of every point). Last entry: as fast as possible.</summary>
    private static readonly double[] StepsPerSecond = [100, 300, 1000, 3000, 10000, double.PositiveInfinity];
    private const int DefaultSpeedIndex = 4;

    private readonly StrangeAttractorController _controller = new(DiagramSize);
    private readonly StepPacer _pacer = new();
    private DrawBatch _diagram = null!;
    private DrawBatch _overlay = null!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<StrangeAttractorPage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private int _speedIndex = DefaultSpeedIndex;
    private bool _disposed;

    private bool IsStopped => _controller.Status == IterationStatus.Stopped;

    private bool CanPressStart => _controller.Status == IterationStatus.Interrupted || (IsStopped && _controller.CanStart);

    private string SpeedLabel => double.IsPositiveInfinity(StepsPerSecond[_speedIndex])
        ? Text.Get("SpeedMax")
        : $"{StepsPerSecond[_speedIndex]:N0} {Text.Get("StepsPerSecond")}";

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static int IntValue(ChangeEventArgs e) => int.Parse(Value(e), CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        _names = _controller.AttractorNames.ToList();
        CreateBatches();
    }

    private void CreateBatches()
    {
        _diagram = new DrawBatch(_controller.Transform);
        _overlay = new DrawBatch(_controller.Transform);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "attractor-diagram", DiagramSize);
        await _module.InvokeVoidAsync("setup", "attractor-overlay", DiagramSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "attractor-overlay", _selfReference);
        await PrepareAsync();
    }

    /// <summary>VB: ResetIteration / DrawCoordinateCube; the drawn points are cleared (PicDiagram.Refresh).</summary>
    private async Task PrepareAsync()
    {
        DrawCube();
        _overlay.Clear();
        await FlushAsync();
    }

    private void DrawCube()
    {
        _diagram.Clear();
        var (lines, points) = _controller.CoordinateCube();
        foreach (var line in lines)
        {
            _diagram.Line(line.A, line.B, line.IsRed ? CanvasColor.Red : CanvasColor.Black, line.Width);
        }

        foreach (var point in points)
        {
            _diagram.Point(point.Point, point.IsRed ? CanvasColor.Red : CanvasColor.Black, point.Size);
        }
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (!_diagram.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "attractor-diagram", _diagram.Take());
        }

        if (!_overlay.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "attractor-overlay", _overlay.Take());
        }
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectSystem(IntValue(e));
        CreateBatches();
        await PrepareAsync();
    }

    private void OnPointSetChanged(ChangeEventArgs e)
    {
        _error = null;
        _controller.SetStartPointSet(IntValue(e));
    }

    private async Task OnDSParameterChangedAsync(ChangeEventArgs e)
    {
        _controller.SetDSParameterFromTrackBar(IntValue(e));
        await PrepareAsync();
    }

    private async Task OnProjectionChangedAsync(AttractorProjection projection)
    {
        _controller.SetProjection(projection);
        await PrepareAsync();
    }

    private async Task TakeOverAsync()
    {
        _error = _controller.TakeOverPointSet();
        if (_error is null)
        {
            foreach (var point in _controller.StartPoints())
            {
                _overlay.Point(point.Plane, point.Color, 3);
            }

            await FlushAsync();
        }
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        await PrepareAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.SetDefaultUserData();
        await PrepareAsync();
    }

    private async Task StartAsync()
    {
        if (_controller.IsNewStart)
        {
            // VB: PicDiagram.Refresh clears the start points
            _overlay.Clear();
        }

        if (!_controller.Start())
        {
            return;
        }

        var watch = new System.Diagnostics.Stopwatch();
        _pacer.Restart();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            var passes = _pacer.NextSteps(StepsPerSecond[_speedIndex]);
            watch.Restart();
            for (var i = 0; i < passes && watch.Elapsed.TotalMilliseconds < FrameBudgetMs; i++)
            {
                foreach (var point in _controller.Step())
                {
                    _overlay.Point(point.Plane, point.Color, 1);
                }
            }

            await FlushAsync();
            StateHasChanged();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        switch (kind)
        {
            case "down":
                _controller.MouseDown();
                break;
            case "move":
                if (_controller.MouseMove((int)Math.Round(x), (int)Math.Round(y)))
                {
                    // VB: DrawCoordinateCube clears the picture
                    await PrepareAsync();
                    StateHasChanged();
                }
                break;
            default:
                _controller.MouseUp();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _controller.Stop();
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
