@page "/mandelbrotmap"
@using Dynamics.Core.General
@using Dynamics.Core.Julia
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("MnuMandelbrotMap") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("MnuMandelbrotMap")</h1>

<div class="map-toolbar">
    <div class="complex-input">
        <label for="ca">c =</label>
        <input id="ca" readonly value="@_controller.A" />
        <label for="cb">+ i</label>
        <input id="cb" readonly value="@_controller.B" />
    </div>
    <button type="button" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
</div>

<div class="map-page">
    <section>
        <div class="canvas-stack diagram" style="--size:@(MandelbrotSize)px">
            <canvas id="map-mandelbrot" class="pixel-image"></canvas>
            <canvas id="map-mandelbrot-overlay" class="@(_controller.IsMandelbrotComplete ? "selectable-point" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("MandelbrotMapMouseHint")</p>
    </section>
    <section>
        <div class="canvas-stack diagram" style="--size:@(JuliaSize)px">
            <canvas id="map-julia" class="pixel-image"></canvas>
        </div>
    </section>
</div>

@code {
    // VB: FrmMandelbrotMap.Designer (PicMandelbrot 600 x 600, PicJulia 563 x 563)
    private const int MandelbrotSize = 600;
    private const int JuliaSize = 563;
    private const double FrameBudgetMs = 15;

    private readonly MandelbrotMapController _controller = new(MandelbrotSize, JuliaSize);
    private readonly PixelImage _mandelbrotImage = new(MandelbrotSize);
    private readonly PixelImage _juliaImage = new(JuliaSize);

    private IJSObjectReference? _module;
    private DotNetObjectReference<MandelbrotMapPage>? _selfReference;
    private string? _error;
    private bool _isLoopRunning;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "map-mandelbrot", MandelbrotSize, true);
        await _module.InvokeVoidAsync("setup", "map-mandelbrot-overlay", MandelbrotSize);
        await _module.InvokeVoidAsync("setup", "map-julia", JuliaSize, true);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "map-mandelbrot-overlay", _selfReference);

        PrepareImage(_mandelbrotImage, _controller.DSMandelbrot);
        PrepareImage(_juliaImage, _controller.DSJulia);
        await RunAsync();
    }

    /// <summary>VB: ResetIteration of a model, clear the bitmap and draw the coordinate system.</summary>
    private static void PrepareImage(PixelImage image, IJulia ds)
    {
        image.Clear();
        image.DrawAxes(ds.Transform);
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _mandelbrotImage.FlushAsync(_module, "map-mandelbrot");
        await _juliaImage.FlushAsync(_module, "map-julia");
    }

    /// <summary>Computes the pictures frame by frame until both are complete.</summary>
    private async Task RunAsync()
    {
        if (_isLoopRunning)
        {
            return;
        }

        _isLoopRunning = true;
        try
        {
            var watch = new System.Diagnostics.Stopwatch();
            while (_controller.IsRunning && !_disposed)
            {
                watch.Restart();
                while (watch.Elapsed.TotalMilliseconds < FrameBudgetMs && _controller.Step(out var isMandelbrot, out var step))
                {
                    (isMandelbrot ? _mandelbrotImage : _juliaImage).Set(step.P, step.Q, step.Pixel.Color);
                }

                await FlushAsync();
                StateHasChanged();
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("nextFrame");
                }
            }
        }
        finally
        {
            _isLoopRunning = false;
        }

        StateHasChanged();
    }

    private async Task RestartJuliaAsync(string? error)
    {
        _error = error;
        StateHasChanged();
        if (error is null)
        {
            PrepareImage(_juliaImage, _controller.DSJulia);
            await FlushAsync();
            await RunAsync();
        }
    }

    private Task DefaultAsync() => RestartJuliaAsync(_controller.SetDefaultUserData());

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        // c of the bitmap pixel under the mouse
        var (p, q) = SpiralScan.PixelAt(
            Math.Clamp((int)Math.Floor(x), 0, MandelbrotSize - 1),
            Math.Clamp((int)Math.Floor(y), 0, MandelbrotSize - 1));
        switch (kind)
        {
            case "down":
                if (_controller.MouseDown(p, q))
                {
                    StateHasChanged();
                }
                break;
            case "move":
                if (_controller.MouseMove(p, q))
                {
                    StateHasChanged();
                }
                break;
            default:
                if (_controller.MouseUp(out var error))
                {
                    await RestartJuliaAsync(error);
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
