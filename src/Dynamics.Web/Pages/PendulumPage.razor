@page "/pendulum"
@using System.Diagnostics
@using Dynamics.Core.General
@using Dynamics.Core.Pendulum
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("Pendulum") – Dynamics</PageTitle>

<div class="pendulum-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(PendulumRenderer.DiagramSize)px">
            <canvas id="pendulum-diagram"></canvas>
            <canvas id="pendulum-overlay" class="@(CanSetStartPosition ? "settable" : "")"></canvas>
        </div>
        <div class="energy" title="@Text.Get("Energy")">
            <div class="energy-bar @EnergyClass" style="width:@(EnergyPercent)%"></div>
        </div>
        <p class="hint">@Hint</p>
        @if (_errorMessage is not null)
        {
            <p class="error" role="alert">@_errorMessage</p>
        }
    </section>

    <section class="control-column">
        <div class="field">
            <label for="pendulum-type">@Text.Get("Pendulum")</label>
            <select id="pendulum-type" disabled="@(!IsEditable)" @onchange="OnPendulumChanged">
                @for (var i = 0; i < _pendulumNames.Count; i++)
                {
                    <option value="@i" selected="@(i == _pendulumIndex)">@_pendulumNames[i]</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="additional">@_controller.AdditionalParameterLabel</label>
            <input id="additional" type="range" min="@_controller.AdditionalParameterRange.Min" max="@_controller.AdditionalParameterRange.Max"
                   value="@_controller.MainDS.AdditionalParameterValue" disabled="@(!IsEditable)" @onchange="OnAdditionalParameterChanged" />
        </div>

        <div class="field">
            <label for="stepwidth">@_controller.StepWidthLabel</label>
            <input id="stepwidth" type="range" min="1" max="20" value="@_controller.StepWidth"
                   @oninput="OnStepWidthChanged" />
        </div>

        <div class="field">
            <label for="speed">@Text.Get("AnimationSpeed"): @SpeedLabel</label>
            <input id="speed" type="range" min="0" max="@(SpeedFactors.Length - 1)" value="@_speedIndex"
                   @oninput="e => _speedIndex = int.Parse(e.Value!.ToString()!)" />
        </div>

        <fieldset disabled="@(!IsEditable)">
            <legend>@Text.Get("StartParameter")</legend>
            <div class="parameters">
                @for (var i = 0; i < _parameterTexts.Length; i++)
                {
                    var index = i;
                    var definition = _controller.MainDS.ValueParameterDefinition[index];
                    <label for="p@(index)">@definition.Name</label>
                    <input id="p@(index)" class="@(_invalid.Contains(index) ? "invalid" : "")" inputmode="double"
                           value="@_parameterTexts[index]" @onchange="e => _parameterTexts[index] = e.Value?.ToString() ?? string.Empty" />
                }
            </div>
            <button type="button" @onclick="TakeOverStartParameter">@Text.Get("TakeOver")</button>
        </fieldset>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Interrupted ? Text.Get("Continue") : Text.Get("Start"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
            <button type="button" disabled="@(!IsEditable || _controller.ShadowDS is not null)" @onclick="CreateShadowAsync">@Text.Get("CreatePendulum")</button>
        </div>

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_controller.N.ToString("N0")</strong></p>
    </section>

    <section class="phase-column">
        <div class="field">
            <label for="phase-type">@Text.Get("TypeofPhaseportrait")</label>
            <select id="phase-type" disabled="@(!IsEditable)" @onchange="OnPhasePortraitChanged">
                @{ var phaseIndex = 0; }
                @foreach (var name in PendulumController.PhasePortraitNames)
                {
                    <option value="@phaseIndex" selected="@(phaseIndex == (int)_controller.PhasePortraitType)">@name</option>
                    phaseIndex++;
                }
            </select>
        </div>
        <p class="caption">@_controller.MainDS.LabelPhasePortrait</p>
        <div class="canvas-stack phase" style="--size:@(PendulumRenderer.PhasePortraitSize)px">
            <canvas id="phase-portrait"></canvas>
            <canvas id="phase-overlay"></canvas>
        </div>

        <label class="check">
            <input type="checkbox" checked="@_controller.IsProtocol" disabled="@(!IsEditable)"
                   @onchange="e => _controller.IsProtocol = e.Value is true" />
            @Text.Get("Protocol")
        </label>
        <p class="caption">@_controller.MainDS.LabelProtocol</p>
        <div class="protocol" role="log">
            @foreach (var line in _protocol.TakeLast(ProtocolDisplayLines).Reverse())
            {
                <div>@line</div>
            }
        </div>
    </section>
</div>

@code {
    private const int ProtocolDisplayLines = 200;
    private const int ProtocolMaxLines = 10000;
    private const double FrameBudgetMs = 12;

    /// <summary>
    /// Speed relative to real time: lengths are in metres and g = 9.81 m/s², so the step width d is in seconds
    /// and 1/d steps per second is real time. The last entry is "as fast as possible".
    /// </summary>
    private static readonly double[] SpeedFactors = [0.1, 0.25, 0.5, 1, 2, 5, 10, 25, double.PositiveInfinity];
    private const int RealTimeIndex = 3;

    private readonly StepPacer _pacer = new();
    private int _speedIndex = RealTimeIndex;

    private string SpeedLabel => SpeedFactors[_speedIndex] switch
    {
        double.PositiveInfinity => Text.Get("SpeedMax"),
        1 => $"1× ({Text.Get("RealTime")})",
        var factor => $"{factor}×",
    };

    private double StepsPerSecond => SpeedFactors[_speedIndex] / (double)_controller.MainDS.StepWidthValue;

    private readonly PendulumController _controller = new();
    private readonly PendulumRenderer _renderer = new();
    private readonly List<string> _protocol = [];
    private readonly HashSet<int> _invalid = [];

    private IJSObjectReference? _module;
    private DotNetObjectReference<PendulumPage>? _selfReference;
    private List<string> _pendulumNames = [];
    private int _pendulumIndex;
    private string[] _parameterTexts = [];
    private EnergyState _energyState;
    private double _energyFraction;
    private bool _disposed;
    private string? _errorMessage;

    private bool IsEditable => _controller.IsEditable;

    private bool CanSetStartPosition => IsEditable &&
        !(_controller.MainDS.IsStartparameter1Set && _controller.MainDS.IsStartparameter2Set);

    private string Hint => CanSetStartPosition ? Text.Get("PendulumMouseHint") : "";

    private string EnergyClass => _energyState switch
    {
        EnergyState.TooHigh => "too-high",
        EnergyState.TooLow => "too-low",
        _ => "ok",
    };

    private double EnergyPercent => _controller.N == 0 ? 0 : _energyFraction * 100;

    protected override void OnInitialized()
    {
        _pendulumNames = _controller.PendulumNames.ToList();
        RefreshParameterTexts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "pendulum-diagram", PendulumRenderer.DiagramSize);
        await _module.InvokeVoidAsync("setup", "pendulum-overlay", PendulumRenderer.DiagramSize);
        await _module.InvokeVoidAsync("setup", "phase-portrait", PendulumRenderer.PhasePortraitSize);
        await _module.InvokeVoidAsync("setup", "phase-overlay", PendulumRenderer.PhasePortraitSize);

        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "pendulum-overlay", _selfReference);

        await PrepareAsync();
    }

    private void RefreshParameterTexts()
    {
        _parameterTexts = _controller.GetStartParameterValues().Select(v => v.ToString()).ToArray();
        _invalid.Clear();
    }

    /// <summary>Clears all diagrams and draws axes and pendulums (VB: ResetIteration + PrepareDiagram).</summary>
    private async Task PrepareAsync()
    {
        _errorMessage = null;
        _protocol.Clear();
        _energyFraction = 0;
        _energyState = EnergyState.Ok;
        _renderer.Prepare(_controller);
        await FlushAsync();
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        await Send("pendulum-diagram", _renderer.Diagram);
        await Send("pendulum-overlay", _renderer.DiagramOverlay);
        await Send("phase-portrait", _renderer.PhasePortrait);
        await Send("phase-overlay", _renderer.PhasePortraitOverlay);
    }

    private async Task Send(string id, DrawBatch batch)
    {
        if (!batch.IsEmpty)
        {
            await _module!.InvokeVoidAsync("draw", id, batch.Take());
        }
    }

    private async Task OnPendulumChanged(ChangeEventArgs e)
    {
        _pendulumIndex = int.Parse(e.Value!.ToString()!);
        _controller.SelectPendulum(_pendulumIndex);
        RefreshParameterTexts();
        await PrepareAsync();
    }

    private async Task OnAdditionalParameterChanged(ChangeEventArgs e)
    {
        _controller.SetAdditionalParameter(int.Parse(e.Value!.ToString()!));
        _controller.ResetIteration();
        RefreshParameterTexts();
        await PrepareAsync();
    }

    private void OnStepWidthChanged(ChangeEventArgs e) => _controller.SetStepWidth(int.Parse(e.Value!.ToString()!));

    private async Task OnPhasePortraitChanged(ChangeEventArgs e)
    {
        _controller.SetPhasePortraitType((PhasePortraitType)int.Parse(e.Value!.ToString()!));
        _renderer.ClearPhasePortrait(_controller);
        await FlushAsync();
    }

    private async Task TakeOverStartParameter()
    {
        _invalid.Clear();
        for (var i = 0; i < _parameterTexts.Length; i++)
        {
            if (!_controller.TryParseParameter(i, _parameterTexts[i], out _))
            {
                _invalid.Add(i);
            }
        }

        if (_invalid.Count > 0 || !_controller.TakeOverStartParameter(_parameterTexts))
        {
            return;
        }

        _renderer.DrawPendulums(_controller);
        await FlushAsync();
    }

    private async Task ResetAsync()
    {
        _controller.ResetIteration();
        await PrepareAsync();
    }

    private async Task DefaultAsync()
    {
        _controller.ResetIteration();
        _controller.SetDefaultUserData();
        RefreshParameterTexts();
        await PrepareAsync();
    }

    private async Task CreateShadowAsync()
    {
        _controller.CreateShadow();
        await PrepareAsync();
    }

    private void Stop() => _controller.Stop();

    private async Task StartAsync()
    {
        if (_controller.Status == IterationStatus.Stopped)
        {
            // VB: IsUserDataOK checks the fields before starting.
            _invalid.Clear();
            for (var i = 0; i < _parameterTexts.Length; i++)
            {
                if (!_controller.TryParseParameter(i, _parameterTexts[i], out _))
                {
                    _invalid.Add(i);
                }
            }
            if (_invalid.Count > 0)
            {
                return;
            }
        }

        if (!_controller.Start())
        {
            return;
        }

        await RunLoopAsync();
    }

    private async Task RunLoopAsync()
    {
        var watch = new Stopwatch();
        _pacer.Restart();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            // The steps due at the chosen speed, but at most what fits into the frame budget.
            var steps = _pacer.NextSteps(StepsPerSecond);
            watch.Restart();
            try
            {
                for (var i = 0; i < steps && watch.Elapsed.TotalMilliseconds < FrameBudgetMs; i++)
                {
                    if (_controller.IsProtocol)
                    {
                        // VB protocols the values before each step.
                        _protocol.Add(_controller.MainDS.GetProtocolLine());
                    }

                    _controller.Step();
                    _renderer.DrawStep(_controller);
                }
            }
            catch (ArithmeticException)
            {
                // The pendulum became numerically unstable (e.g. double overflow).
                _controller.Stop();
                _errorMessage = Text.Get("NumericOverflow");
            }

            if (_protocol.Count > ProtocolMaxLines)
            {
                _protocol.RemoveRange(0, _protocol.Count - ProtocolMaxLines);
            }

            if (_errorMessage is null)
            {
                (_energyState, _energyFraction) = _controller.GetEnergyBar();
            }
            _renderer.DrawPendulums(_controller);
            await FlushAsync();
            StateHasChanged();

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        // Simulator added 2 pixels to X because of the hand cursor; not needed here.
        var position = _renderer.DiagramTransform.PixelToMathPoint((int)Math.Round(x), (int)Math.Round(y));
        var changed = kind switch
        {
            "down" => _controller.MouseDown(position),
            "move" => _controller.MouseMove(position),
            _ => false,
        };

        if (kind == "up")
        {
            _controller.MouseUp();
            StateHasChanged();
            return;
        }

        if (changed)
        {
            RefreshParameterTexts();
            _renderer.DrawPendulums(_controller);
            await FlushAsync();
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _controller.Stop();
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
