@page "/billiard"
@using System.Globalization
@using Dynamics.Core.Billiard
@using Dynamics.Core.General
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("Billiard") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("Billiard")</h1>

<div class="billiard-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(TableSize)px">
            <canvas id="billiard-table"></canvas>
            <canvas id="billiard-overlay" class="@(_controller.CanSetWithMouse ? "selectable-point" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("BilliardMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="table">@Text.Get("MnuBilliardTable")</label>
            <select id="table" disabled="@(!IsStopped)" @onchange="OnTableChangedAsync">
                @for (var i = 0; i < _names.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="parameter">@Text.Get("ParameterC")</label>
            <div class="field-row">
                <input id="parameter" class="grow" type="range" min="@_controller.ParameterTrackBarMinimum" max="@_controller.ParameterTrackBarMaximum"
                       value="@_controller.ParameterTrackBar" disabled="@(!IsStopped)" @oninput="OnParameterTrackBarAsync" />
                <input class="short" inputmode="decimal" value="@_controller.ParameterText" disabled="@(!IsStopped)"
                       @oninput="e => _controller.ParameterText = Value(e)" @onchange="OnParameterTextAsync" />
            </div>
        </div>

        <div class="field-row">
            <div class="field grow">
                <label for="color">@Text.Get("BallColor")</label>
                <select id="color" disabled="@(!IsStopped)" @onchange="e => _controller.SetColor(IntValue(e))">
                    @for (var i = 0; i < BilliardTableController.BallColors.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.ColorIndex)">@Text.Get(BilliardTableController.BallColors[i].Name)</option>
                    }
                </select>
            </div>
            <span class="swatch" style="background:@Css(_controller.SelectedColor.Argb)"></span>
        </div>

        <div class="field">
            <label for="speed">@Text.Get("BallSpeed") @_controller.Speed</label>
            <input id="speed" type="range" min="@BilliardTableController.SpeedMinimum" max="@BilliardTableController.SpeedMaximum"
                   value="@_controller.Speed" @oninput="e => _controller.SetSpeed(IntValue(e))" />
        </div>

        <fieldset>
            <legend>@Text.Get("StartParameter")</legend>
            <div class="complex-input">
                <label for="t">t</label>
                <input id="t" inputmode="decimal" value="@_controller.TText" disabled="@(!IsStopped)" @oninput="e => _controller.TText = Value(e)" />
                <label for="alfa">@Text.Get("Alfa")</label>
                <input id="alfa" inputmode="decimal" value="@_controller.AlfaText" disabled="@(!IsStopped)" @oninput="e => _controller.AlfaText = Value(e)" />
            </div>
            <div class="buttons top-gap">
                <button type="button" disabled="@(!IsStopped)" @onclick="NewBallAsync">@Text.Get("NewBall")</button>
                <button type="button" disabled="@(!IsStopped)" @onclick="TakeOverAsync">@Text.Get("TakeOver")</button>
            </div>
        </fieldset>

        <label class="check">
            <input type="checkbox" checked="@_controller.IsProtocol" disabled="@(!IsStopped)" @onchange="e => _controller.IsProtocol = e.Value is true" />
            @Text.Get("Protocol")
        </label>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running || _isAnimating)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Stopped ? Text.Get("Start") : Text.Get("Continue"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(!_controller.CanNextStep || _isAnimating)" @onclick="NextStepAsync">@Text.Get("NextStep")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running || _isAnimating)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!IsStopped)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
            <button type="button" disabled="@(!IsStopped)" @onclick="FillPhasePortraitAsync">@Text.Get("FillPhasePortrait")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_controller.Steps.ToString("N0")</strong></p>
    </section>

    <section class="phase-column">
        <p class="caption">@Text.Get("PhasePortrait"): t, alfa</p>
        <div class="canvas-stack phase" style="--size:@(PhaseSize)px">
            <canvas id="billiard-phase"></canvas>
        </div>
        <p class="caption">@Text.Get("Protocol")</p>
        <div class="protocol billiard-protocol" role="log">
            @foreach (var line in _controller.Protocol.TakeLast(DisplayLines).Reverse())
            {
                <div>@line</div>
            }
        </div>
    </section>
</div>

@code {
    // VB: FrmBilliardTable.Designer, PicDiagram 600 x 600, PicPhasePortrait 320 x 320
    private const int TableSize = 600;
    private const int PhaseSize = 320;
    private const int DisplayLines = 200;

    /// <summary>Drawing steps of the moving ball per second (VB: one Refresh per step).</summary>
    private const double PositionsPerSecond = 300;

    private readonly BilliardTableController _controller = new();
    private readonly StepPacer _pacer = new();
    private readonly Queue<BilliardDrawing> _queue = new();
    private DrawBatch _table = null!;
    private DrawBatch _overlay = null!;
    private DrawBatch _phase = null!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<BilliardPage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private bool _isAnimating;
    private bool _disposed;

    // The segment being animated
    private OrbitSegment? _segment;
    private int _segmentIndex;
    private MathPoint? _segmentLast;

    private bool IsStopped => _controller.Status == IterationStatus.Stopped && !_isAnimating;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static int IntValue(ChangeEventArgs e) => int.Parse(Value(e), CultureInfo.InvariantCulture);
    private static string Css(int argb) => $"rgb({Argb.Red(argb)},{Argb.Green(argb)},{Argb.Blue(argb)})";

    protected override void OnInitialized()
    {
        _names = _controller.TableNames.ToList();
        CreateBatches();
    }

    private void CreateBatches()
    {
        var picture = new CoordinateTransform(TableSize, TableSize, _controller.DS.MathInterval, _controller.DS.MathInterval);
        _table = new DrawBatch(picture);
        _overlay = new DrawBatch(picture);
        _phase = new DrawBatch(new CoordinateTransform(PhaseSize, PhaseSize, _controller.DS.TValueParameter.Range, _controller.DS.AlfaValueParameter.Range));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "billiard-table", TableSize);
        await _module.InvokeVoidAsync("setup", "billiard-overlay", TableSize);
        await _module.InvokeVoidAsync("setup", "billiard-phase", PhaseSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "billiard-overlay", _selfReference);
        await PrepareAsync();
    }

    /// <summary>VB: ResetIteration clears the pictures and draws the table.</summary>
    private async Task PrepareAsync()
    {
        _queue.Clear();
        _segment = null;
        CreateBatches();
        _table.Clear();
        foreach (var shape in _controller.DS.DrawBilliardtable())
        {
            switch (shape)
            {
                case TableLine line:
                    _table.Line(line.A, line.B, line.Color, 1);
                    break;
                case TableArc arc:
                    _table.Arc(arc.Center, arc.RadiusX, arc.RadiusY, arc.StartAngle, arc.Sweep, arc.Color, 1);
                    break;
                case TablePoint point:
                    _table.Point(point.Point, point.Color, point.Size);
                    break;
            }
        }

        _overlay.Clear();
        _phase.Clear();
        await FlushAsync();
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (!_table.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "billiard-table", _table.Take());
        }

        if (!_overlay.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "billiard-overlay", _overlay.Take());
        }

        if (!_phase.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "billiard-phase", _phase.Take());
        }
    }

    /// <summary>Draws the drawings of the controller; segments are animated, everything else is drawn at once.</summary>
    private async Task PumpAsync()
    {
        foreach (var drawing in _controller.TakeDrawings())
        {
            _queue.Enqueue(drawing);
        }

        if (_isAnimating)
        {
            return;
        }

        _isAnimating = true;
        _pacer.Restart();
        try
        {
            while (!_disposed && (_queue.Count > 0 || _segment is not null || _controller.Status == IterationStatus.Running))
            {
                var budget = _pacer.NextSteps(PositionsPerSecond);
                while (budget > 0)
                {
                    if (_segment is not null)
                    {
                        // VB MoveOnSegment: the trace permanently, the ball temporarily
                        var position = _segment.Positions[_segmentIndex++];
                        _table.Line(_segmentLast!, position, _segment.Color, 1);
                        _overlay.Clear();
                        _overlay.Point(position, _segment.Color, BilliardBallBase.BallSize);
                        _segmentLast = position;
                        budget--;
                        if (_segmentIndex >= _segment.Positions.Count)
                        {
                            _segment = null;
                        }

                        continue;
                    }

                    if (_queue.Count == 0)
                    {
                        if (_controller.Status != IterationStatus.Running)
                        {
                            break;
                        }

                        _controller.Step();
                        foreach (var drawing in _controller.TakeDrawings())
                        {
                            _queue.Enqueue(drawing);
                        }

                        continue;
                    }

                    Draw(_queue.Dequeue());
                }

                await FlushAsync();
                StateHasChanged();
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("nextFrame");
                }
            }
        }
        finally
        {
            _isAnimating = false;
        }

        StateHasChanged();
    }

    private void Draw(BilliardDrawing drawing)
    {
        switch (drawing)
        {
            case PermanentBall ball:
                _table.Point(ball.Position, ball.Color, BilliardBallBase.BallSize);
                break;
            case TemporaryBall ball:
                _overlay.Clear();
                _overlay.Point(ball.Position, ball.Color, BilliardBallBase.BallSize);
                if (ball.LineStart is { } start)
                {
                    _overlay.Line(start, ball.Position, ball.Color, 1);
                }
                break;
            case OrbitSegment segment:
                _segment = segment;
                _segmentIndex = 0;
                _segmentLast = segment.Start;
                break;
            case PhasePortraitPoint point:
                _phase.Point(new MathPoint(point.Point.T, point.Point.Alfa), point.Color, BilliardBallBase.PhasePointSize);
                break;
        }
    }

    private async Task OnTableChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectTable(IntValue(e));
        await PrepareAsync();
    }

    private async Task OnParameterTrackBarAsync(ChangeEventArgs e)
    {
        _controller.SetParameterFromTrackBar(IntValue(e));
        await PrepareAsync();
    }

    private async Task OnParameterTextAsync(ChangeEventArgs e)
    {
        _controller.ParameterText = Value(e);
        _error = _controller.TakeOverParameterText();
        if (_error is null)
        {
            await PrepareAsync();
        }
    }

    private async Task NewBallAsync()
    {
        _error = _controller.CreateNewBall();
        await PumpAsync();
    }

    private async Task TakeOverAsync()
    {
        _error = _controller.TakeOverStartParameter();
        await PumpAsync();
    }

    private async Task FillPhasePortraitAsync()
    {
        _error = null;
        await PrepareAsync();
        _error = _controller.PrepareBallsForPhasePortrait();
        await PumpAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        await PrepareAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.DefaultUserData();
        await PrepareAsync();
    }

    private async Task StartAsync()
    {
        _error = _controller.Start();
        if (_controller.IsResetByStart)
        {
            // VB: invalid user data resets the iteration
            await PrepareAsync();
            return;
        }

        await PumpAsync();
    }

    private async Task NextStepAsync()
    {
        _error = _controller.NextStep();
        await PumpAsync();
    }

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var position = _table.Transform.PixelToMathPoint((int)Math.Round(x), (int)Math.Round(y));
        var changed = kind switch
        {
            "down" => _controller.MouseDown(position),
            "move" => _controller.MouseMove(position),
            _ => _controller.MouseUp(position),
        };

        if (changed)
        {
            await PumpAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _controller.Stop();
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
