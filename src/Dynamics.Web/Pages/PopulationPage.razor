@page "/population"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.GrowthModel
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("PopulationDensity") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("PopulationDensity")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="population-diagram"></canvas>
        </div>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="function">@Text.Get("Function")</label>
            <select id="function" disabled="@(!_controller.IsEditable)" @onchange="OnSystemChangedAsync">
                @for (var i = 0; i < _names.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="trackbar">@Text.Get("Parameter") a</label>
            <input id="trackbar" type="range" min="1" max="1000" value="@_controller.TrackBar" disabled="@(!_controller.IsEditable)"
                   @oninput="OnTrackBarAsync" />
        </div>

        <div class="field-row">
            <div class="field grow">
                <label for="parameter">a =</label>
                <input id="parameter" inputmode="double" value="@_controller.ParameterA" disabled="@(!_controller.IsEditable)"
                       @onchange="OnParameterAsync" />
            </div>
            <div class="field grow">
                <label for="start">@Text.Get("StartValue")</label>
                <input id="start" inputmode="double" value="@_controller.StartValue" disabled="@(!_controller.IsEditable)"
                       @onchange="OnStartValueAsync" />
            </div>
        </div>

        <div class="field">
            <label for="speed">@Text.Get("AnimationSpeed"): @SpeedLabel</label>
            <input id="speed" type="range" min="0" max="@(StepsPerSecond.Length - 1)" value="@_speedIndex"
                   @oninput="e => _speedIndex = int.Parse(e.Value!.ToString()!, CultureInfo.InvariantCulture)" />
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Stopped ? Text.Get("Start") : Text.Get("Continue"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="NextStepAsync">@Text.Get("NextStep")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_controller.N.ToString("N0")</strong></p>
        <p class="steps">@Text.Get("PopulationDensity"): <strong>@_controller.PopulationDensity %</strong></p>
    </section>
</div>

@code {
    // VB: FrmPopulation.Designer, PicDiagram 580 x 580
    private const int DiagramSize = 580;

    /// <summary>Iteration steps per second; VB ran as fast as the machine allowed. Last entry: as fast as possible.</summary>
    private static readonly double[] StepsPerSecond = [0.5, 1, 2, 5, 10, 20, double.PositiveInfinity];
    private const int DefaultSpeedIndex = 2;

    private readonly PopulationController _controller = new();
    private readonly StepPacer _pacer = new();

    private IJSObjectReference? _module;
    private List<string> _names = [];
    private string? _error;
    private bool _disposed;
    private int _speedIndex = DefaultSpeedIndex;

    private string SpeedLabel => double.IsPositiveInfinity(StepsPerSecond[_speedIndex])
        ? Text.Get("SpeedMax")
        : $"{StepsPerSecond[_speedIndex].ToString(CultureInfo.CurrentCulture)} {Text.Get("StepsPerSecond")}";

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    protected override void OnInitialized() => _names = _controller.Names.ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "population-diagram", DiagramSize);
        await DrawAsync(_controller.StartPicture());
    }

    /// <summary>VB: ShowPopulation, the red living circle and the individuals as blue points.</summary>
    private async Task DrawAsync(PopulationPicture? picture)
    {
        var range = _controller.DS.ValueParameter.Range;
        var batch = new DrawBatch(new CoordinateTransform(DiagramSize, DiagramSize, range, range));
        batch.Clear();
        if (picture is not null)
        {
            batch.Circle(picture.Center, picture.Radius, CanvasColor.Red, 1);
            foreach (var individual in picture.Individuals)
            {
                batch.Point(individual, CanvasColor.Blue, PopulationController.D);
            }
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("draw", "population-diagram", batch.Take());
        }
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectSystem(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await DrawAsync(_controller.StartPicture());
    }

    /// <summary>VB: SetParameterA shows the start population again.</summary>
    private async Task OnTrackBarAsync(ChangeEventArgs e)
    {
        _controller.SetTrackBar(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await DrawAsync(_controller.StartPicture());
    }

    private async Task OnParameterAsync(ChangeEventArgs e)
    {
        _error = _controller.SetParameterA(Value(e));
        await DrawAsync(_controller.StartPicture());
    }

    /// <summary>VB: TxtStartValue LostFocus resets the iteration.</summary>
    private async Task OnStartValueAsync(ChangeEventArgs e)
    {
        _controller.StartValue = Value(e);
        await ResetAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        await DrawAsync(_controller.StartPicture());
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.DefaultUserData();
        await DrawAsync(_controller.StartPicture());
    }

    private async Task NextStepAsync()
    {
        _error = _controller.Start(single: true);
        if (_error is null)
        {
            await DrawAsync(_controller.Step());
        }
    }

    private async Task StartAsync()
    {
        _error = _controller.Start(single: false);
        _pacer.Restart();
        var first = true;
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            // One step right away, then paced; every step is shown (as in VB), so "maximum" is one step per frame
            var steps = first ? 1 : _pacer.NextSteps(StepsPerSecond[_speedIndex]);
            first = false;
            if (steps > 0)
            {
                await DrawAsync(_controller.Step());
                StateHasChanged();
            }

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
