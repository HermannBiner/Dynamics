@page "/cdiagram"
@using System.Globalization
@using Dynamics.Core.Billiard
@using Dynamics.Core.General
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("C-Diagram") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("C-Diagram")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="cdiagram-diagram"></canvas>
            <canvas id="cdiagram-overlay" class="@(_controller.IsEditable ? "selectable" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("JuliaMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="table">@Text.Get("MnuBilliardTable")</label>
            <select id="table" disabled="@(!_controller.IsEditable)" @onchange="OnTableChangedAsync">
                @for (var i = 0; i < _names.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="value">@Text.Get("ExaminatedValueParameter")</label>
            <select id="value" disabled="@(!_controller.IsEditable)" @onchange="OnValueParameterChangedAsync">
                @for (var i = 0; i < _controller.DS.ValueParameterList.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedValueParameter)">@Text.Get(_controller.DS.ValueParameterList[i].Name)</option>
                }
            </select>
        </div>

        <p class="caption">@Text.Get("ExaminatedParameterRange")</p>
        <div class="ranges">
            <label for="cmin">CMin</label>
            <input id="cmin" inputmode="decimal" value="@_controller.CMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetCMin(Value(e))" />
            <label for="cmax">CMax</label>
            <input id="cmax" inputmode="decimal" value="@_controller.CMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetCMax(Value(e))" />
            <span class="delta">@_controller.DeltaC</span>
        </div>

        <p class="caption">@Text.Get(_controller.ValueParameter.Name)</p>
        <div class="ranges">
            <label for="vmin">Min</label>
            <input id="vmin" inputmode="decimal" value="@_controller.VMin" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetVMin(Value(e))" />
            <label for="vmax">Max</label>
            <input id="vmax" inputmode="decimal" value="@_controller.VMax" disabled="@(!_controller.IsEditable)" @oninput="e => _controller.SetVMax(Value(e))" />
            <span class="delta">@_controller.DeltaV</span>
        </div>

        <div class="field">
            <label for="position">@Text.Get("PositionStartValue2")@_controller.Position/120</label>
            <input id="position" type="range" min="1" max="@CDiagramController.PositionMaximum" value="@_controller.Position"
                   disabled="@(!_controller.IsEditable)" @oninput="e => _controller.Position = int.Parse(Value(e), CultureInfo.InvariantCulture)" />
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(!_controller.IsEditable)" @onclick="StartAsync">@Text.Get("Start")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">
            @_controller.Columns / @DiagramSize
            &nbsp; @Text.Get("Time"): <strong>@_watch.Elapsed.TotalSeconds.ToString("F1") s</strong>
        </p>
    </section>
</div>

@code {
    // VB: FrmCDiagramBilliard.Designer, PicDiagram 580 x 580 (one column of the diagram per pixel)
    private const int DiagramSize = 580;
    private const double FrameBudgetMs = 15;

    private readonly CDiagramController _controller = new(DiagramSize, DiagramSize);
    private readonly System.Diagnostics.Stopwatch _watch = new();
    private readonly DrawBatch _overlay = new(new CoordinateTransform(DiagramSize, DiagramSize, new Interval(0m, 1m), new Interval(0m, 1m)));

    private IJSObjectReference? _module;
    private DotNetObjectReference<CDiagramPage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private bool _disposed;
    private (int X, int Y)? _selectionStart;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    protected override void OnInitialized() => _names = _controller.TableNames.ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "cdiagram-diagram", DiagramSize);
        await _module.InvokeVoidAsync("setup", "cdiagram-overlay", DiagramSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "cdiagram-overlay", _selfReference);
    }

    private async Task DrawAsync(DrawBatch batch, string canvas)
    {
        if (_module is not null && !batch.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", canvas, batch.Take());
        }
    }

    private async Task ClearAsync()
    {
        var diagram = new DrawBatch(_controller.Transform);
        diagram.Clear();
        await DrawAsync(diagram, "cdiagram-diagram");
    }

    private async Task OnTableChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SelectTable(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await ClearAsync();
    }

    private async Task OnValueParameterChangedAsync(ChangeEventArgs e)
    {
        _error = null;
        _controller.SetValueParameter(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await ClearAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        _controller.ResetIteration();
        _watch.Reset();
        await ClearAsync();
    }

    private async Task DefaultAsync()
    {
        _error = null;
        _controller.DefaultUserData();
        _watch.Reset();
        await ClearAsync();
    }

    private async Task StartAsync()
    {
        _error = _controller.Start();
        await ClearAsync();
        if (_error is not null)
        {
            return;
        }

        var diagram = new DrawBatch(_controller.Transform);
        var watch = new System.Diagnostics.Stopwatch();
        _watch.Restart();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            watch.Restart();
            while (watch.Elapsed.TotalMilliseconds < FrameBudgetMs && _controller.NextColumn() is { } column)
            {
                foreach (var pair in column.Pairs)
                {
                    diagram.Point(new MathPoint(column.C, _controller.DrawnValue(pair)), CanvasColor.Blue, 1);
                }
            }

            if (_controller.Status == IterationStatus.Stopped)
            {
                // VB: DrawSplitPoints, the red line at c = 1
                diagram.VerticalLine(1, CanvasColor.Red, 1);
            }

            await DrawAsync(diagram, "cdiagram-diagram");
            StateHasChanged();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        _watch.Stop();
        StateHasChanged();
    }

    private static (int X, int Y) Pixel(double x, double y) => (
        Math.Clamp((int)Math.Round(x), 1, DiagramSize),
        Math.Clamp((int)Math.Round(y), 1, DiagramSize));

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var point = Pixel(x, y);
        switch (kind)
        {
            case "down":
                if (_controller.IsEditable)
                {
                    _selectionStart = point;
                }
                break;
            case "move":
                if (_selectionStart is { } start)
                {
                    _overlay.Clear();
                    _overlay.PixelRectangle(Math.Min(start.X, point.X), Math.Min(start.Y, point.Y),
                        Math.Abs(start.X - point.X), Math.Abs(start.Y - point.Y), CanvasColor.Red, 2);
                    await DrawAsync(_overlay, "cdiagram-overlay");
                }
                break;
            default:
                if (_selectionStart is { } begin)
                {
                    _selectionStart = null;
                    _overlay.Clear();
                    await DrawAsync(_overlay, "cdiagram-overlay");
                    if (_controller.SelectArea(begin.X, begin.Y, point.X, point.Y))
                    {
                        StateHasChanged();
                    }
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
