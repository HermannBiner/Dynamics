@page "/histogram"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.GrowthModel
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("Histogram") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("Histogram")</h1>

<div class="julia-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram" style="--size:@(DiagramSize)px">
            <canvas id="histogram-diagram"></canvas>
        </div>
    </section>

    <section class="control-column">
        <div class="field">
            <label for="function">@Text.Get("Function")</label>
            <select id="function" disabled="@(!_controller.IsEditable)" @onchange="OnSystemChangedAsync">
                @for (var i = 0; i < _names.Count; i++)
                {
                    <option value="@i" selected="@(i == _controller.SelectedIndex)">@_names[i]</option>
                }
            </select>
        </div>

        <div class="field-row">
            <div class="field grow">
                <label for="parameter">@Text.Get("Parameter") a</label>
                <input id="parameter" inputmode="decimal" value="@_controller.Parameter" disabled="@(!_controller.IsEditable)"
                       @onchange="e => ChangeInputAsync(() => _controller.Parameter = Value(e))" />
            </div>
            <div class="field grow">
                <label for="start">@Text.Get("StartValue")</label>
                <input id="start" inputmode="decimal" value="@_controller.StartValue" disabled="@(!_controller.IsEditable)"
                       @onchange="e => ChangeInputAsync(() => _controller.StartValue = Value(e))" />
            </div>
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Interrupted ? Text.Get("Continue") : Text.Get("Start"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(!_controller.IsEditable)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
        </div>

        @if (_message is not null)
        {
            <p class="error" role="alert">@_message</p>
        }

        <p class="steps">@Text.Get("NumberOfSteps"): <strong>@_controller.N.ToString("N0")</strong></p>
    </section>
</div>

@code {
    // VB: FrmHistogram.Designer, PicDiagram 580 x 580 (one small interval per pixel column, one hit per pixel)
    private const int DiagramSize = 580;
    private const double FrameBudgetMs = 12;

    // VB: Brushes.CadetBlue
    private static readonly int CadetBlue = unchecked((int)0xFF5F9EA0);

    private readonly HistogramController _controller = new(DiagramSize);
    private readonly DrawBatch _diagram = new(new CoordinateTransform(DiagramSize, DiagramSize, new Interval(0m, DiagramSize), new Interval(0m, DiagramSize)));

    private IJSObjectReference? _module;
    private List<string> _names = [];
    private string? _message;
    private bool _disposed;

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";

    protected override void OnInitialized() => _names = _controller.Names.ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "histogram-diagram", DiagramSize);
    }

    /// <summary>VB: redraws the bars i = 1 .. width (the interval 0 is counted but not drawn).</summary>
    private async Task DrawAsync()
    {
        _diagram.Clear();
        var hits = _controller.NumberOfHits;
        for (var i = 1; i <= DiagramSize; i++)
        {
            var height = Math.Min(hits[i], DiagramSize);
            if (height > 0)
            {
                _diagram.FillPixelRectangle(i - 1, DiagramSize - height, 1, height, CadetBlue);
            }
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("draw", "histogram-diagram", _diagram.Take());
        }
    }

    private async Task OnSystemChangedAsync(ChangeEventArgs e)
    {
        _message = null;
        _controller.SelectSystem(int.Parse(Value(e), CultureInfo.InvariantCulture));
        await DrawAsync();
    }

    /// <summary>VB: TxtParameter / TxtStartValue LostFocus resets the iteration.</summary>
    private async Task ChangeInputAsync(Action set)
    {
        set();
        _controller.ResetIteration();
        await DrawAsync();
    }

    private async Task ResetAsync()
    {
        _message = null;
        _controller.ResetIteration();
        await DrawAsync();
    }

    private async Task DefaultAsync()
    {
        _message = null;
        _controller.DefaultUserData();
        await DrawAsync();
    }

    private async Task StartAsync()
    {
        _message = _controller.Start();
        var watch = new System.Diagnostics.Stopwatch();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            watch.Restart();
            while (watch.Elapsed.TotalMilliseconds < FrameBudgetMs && _controller.Status == IterationStatus.Running)
            {
                _controller.Steps(500);
            }

            await DrawAsync();
            StateHasChanged();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        await DrawAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
