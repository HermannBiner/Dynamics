@page "/universe"
@using System.Globalization
@using Dynamics.Core.General
@using Dynamics.Core.Universe
@using Dynamics.Web.Drawing
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Text.Get("MnuUniverse") – Dynamics</PageTitle>

<h1 class="page-title">@Text.Get("MnuUniverse")</h1>

<div class="billiard-page">
    <section class="diagram-column">
        <div class="canvas-stack diagram space" style="--size:@(DiagramSize)px">
            <canvas id="universe-diagram"></canvas>
            <canvas id="universe-overlay" class="@(_controller.CanPlaceNewStar ? "selectable-point" : "")"></canvas>
        </div>
        <p class="hint">@Text.Get("UniverseMouseHint")</p>
    </section>

    <section class="control-column">
        <div class="field-row">
            <div class="field grow">
                <label for="universe">@Text.Get("MnuUniverse")</label>
                <select id="universe" disabled="@(!IsEditable)" @onchange="OnUniverseChangedAsync">
                    @for (var i = 0; i < _names.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedUniverse)">@_names[i]</option>
                    }
                </select>
            </div>
            <div class="field grow">
                <label for="constellation">@Text.Get("Constellation")</label>
                <select id="constellation" disabled="@(!IsEditable)" @onchange="OnConstellationChangedAsync">
                    @for (var i = 0; i < _controller.DS.Constellations.Count; i++)
                    {
                        <option value="@i" selected="@(i == _controller.SelectedConstellation)">@_controller.DS.Constellations[i].Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="buttons">
            <button type="button" disabled="@(!IsEditable)" @onclick="TakeOverConstellationAsync">@Text.Get("TakeOverConstellation")</button>
            <label class="check inline">
                <input type="checkbox" checked="@_controller.IsZoom" disabled="@(!IsEditable)" @onchange="OnZoomChangedAsync" />
                @Text.Get("Zoom")
            </label>
        </div>

        <fieldset>
            <legend>@Text.Get("NewStar")</legend>
            <div class="field-row">
                <div class="field grow">
                    <label for="defaultstar">@Text.Get("Default")</label>
                    <select id="defaultstar" disabled="@(!IsEditable || _controller.NewStar is not null)"
                            @onchange="e => _controller.SelectedDefaultStar = IntValue(e)">
                        @for (var i = 0; i < _controller.DS.ActiveConstellation!.Stars.Count; i++)
                        {
                            <option value="@i" selected="@(i == _controller.SelectedDefaultStar)">@_controller.DS.ActiveConstellation.Stars[i].Name</option>
                        }
                    </select>
                </div>
                <div class="field grow">
                    <label for="starcolor">@Text.Get("StarColor")</label>
                    <select id="starcolor" disabled="@(_controller.NewStar is null)" @onchange="OnColorChangedAsync">
                        @for (var i = 0; i < StarColors.All.Count; i++)
                        {
                            <option value="@i" selected="@(i == _controller.SelectedColor)">@Text.Get(StarColors.All[i].Name)</option>
                        }
                    </select>
                </div>
                <span class="swatch" style="background:@Css(StarColors.All[_controller.SelectedColor].Argb)"></span>
            </div>

            <div class="field">
                <label for="mass">@Text.Get("Mass"): @_controller.MassText</label>
                <input id="mass" type="range" min="@UniverseController.MassTrackBarMinimum" max="@UniverseController.MassTrackBarMaximum"
                       value="@_controller.MassTrackBar" disabled="@(_controller.NewStar is null)" @oninput="OnMassChangedAsync" />
            </div>
            <div class="field">
                <label for="velocity">@Text.Get("Velocity"): @_controller.VXText / @_controller.VYText</label>
                <input id="velocity" type="range" min="@UniverseController.VelocityTrackBarMinimum" max="@UniverseController.VelocityTrackBarMaximum"
                       value="@_controller.VelocityTrackBar" disabled="@(_controller.NewStar is null)" @oninput="OnVelocityChangedAsync" />
            </div>
            <p class="steps">@Text.Get("Position"): @_controller.XText / @_controller.YText</p>

            <div class="buttons top-gap">
                <button type="button" disabled="@(!IsEditable || _controller.DS.ActiveConstellation is null)" @onclick="NewStarAsync">
                    @(_controller.NewStar is null ? Text.Get("NewStar") : Text.Get("Cancel"))
                </button>
                <button type="button" disabled="@(_controller.NewStar is null)" @onclick="SaveStarAsync">@Text.Get("Save")</button>
            </div>
        </fieldset>

        <div class="field">
            <label for="stepwidth">@Text.Get("StepWidth"): @_controller.StepWidth.ToString(CultureInfo.CurrentCulture)</label>
            <input id="stepwidth" type="range" min="@UniverseController.StepWidthTrackBarMinimum" max="@UniverseController.StepWidthTrackBarMaximum"
                   value="@_controller.StepWidthTrackBar" @oninput="e => _controller.SetStepWidthFromTrackBar(IntValue(e))" />
        </div>

        <div class="field">
            <label for="speed">@Text.Get("AnimationSpeed"): @SpeedLabel</label>
            <input id="speed" type="range" min="0" max="@(LoopsPerSecond.Length - 1)" value="@_speedIndex" @oninput="e => _speedIndex = IntValue(e)" />
        </div>

        <div class="radio-row">
            <label class="check">
                <input type="checkbox" checked="@_controller.IsPhasePortrait" @onchange="e => _controller.IsPhasePortrait = e.Value is true" />
                @Text.Get("PhasePortrait")
            </label>
            <label class="check">
                <input type="checkbox" checked="@_controller.IsConservationLaws" disabled="@(_controller.Status == IterationStatus.Running)"
                       @onchange="e => _controller.IsConservationLaws = e.Value is true" />
                @Text.Get("ConservationLaws")
            </label>
        </div>

        <div class="buttons">
            <button type="button" class="primary" disabled="@(_controller.Status == IterationStatus.Running || _controller.NewStar is not null)" @onclick="StartAsync">
                @(_controller.Status == IterationStatus.Stopped ? Text.Get("Start") : Text.Get("Continue"))
            </button>
            <button type="button" disabled="@(_controller.Status != IterationStatus.Running)" @onclick="_controller.Stop">@Text.Get("Stop")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="ResetAsync">@Text.Get("ResetIteration")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="DefaultAsync">@Text.Get("DefaultUserData")</button>
            <button type="button" disabled="@(_controller.Status == IterationStatus.Running)" @onclick="ClearUniverseAsync">@Text.Get("ClearUniverse")</button>
        </div>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <p class="steps">
            @Text.Get("NumberOfSteps"): <strong>@_controller.Steps.ToString("N0")</strong>
            &nbsp; @Text.Get("Time"): <strong>@_controller.Elapsed.TotalSeconds.ToString("F2") s</strong>
        </p>
    </section>

    <section class="phase-column">
        <p class="caption">@Text.Get("PhasePortrait"): ρ, |v|</p>
        <div class="canvas-stack phase" style="--size:@(PhaseSize)px">
            <canvas id="universe-phase"></canvas>
        </div>
        @if (_controller.IsConservationLaws)
        {
            <div class="conservation">
                @foreach (var (label, bar) in new[] { (Text.Get("Energy"), _controller.Energy), (Text.Get("Angular Momentum"), _controller.AngularMomentum), (Text.Get("Pulse"), _controller.Pulse) })
                {
                    <p class="caption">@label</p>
                    <div class="energy"><div class="energy-bar @BarClass(bar.State)" style="width:@((bar.Fraction * 100).ToString("F1", CultureInfo.InvariantCulture))%"></div></div>
                }
            </div>
        }
    </section>
</div>

@code {
    // VB: FrmUniverse.Designer, PicDiagram 600 x 600, PicPhasePortrait 320 x 320 (square)
    private const int DiagramSize = 600;
    private const int PhaseSize = 320;
    private const double FrameBudgetMs = 12;

    /// <summary>Loops per second (one loop moves every star). Last entry: as fast as possible.</summary>
    private static readonly double[] LoopsPerSecond = [10, 30, 100, 300, 1000, double.PositiveInfinity];
    private const int DefaultSpeedIndex = 5;

    private readonly UniverseController _controller = new();
    private readonly StepPacer _pacer = new();
    private DrawBatch _diagram = null!;
    private DrawBatch _overlay = null!;
    private DrawBatch _phase = null!;

    private IJSObjectReference? _module;
    private DotNetObjectReference<UniversePage>? _selfReference;
    private List<string> _names = [];
    private string? _error;
    private int _speedIndex = DefaultSpeedIndex;
    private bool _disposed;

    private bool IsEditable => _controller.IsStopped;

    private string SpeedLabel => double.IsPositiveInfinity(LoopsPerSecond[_speedIndex])
        ? Text.Get("SpeedMax")
        : $"{LoopsPerSecond[_speedIndex]:N0} {Text.Get("StepsPerSecond")}";

    private static string Value(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static int IntValue(ChangeEventArgs e) => int.Parse(Value(e), CultureInfo.InvariantCulture);
    private static string Css(int argb) => $"rgb({Argb.Red(argb)},{Argb.Green(argb)},{Argb.Blue(argb)})";

    private static string BarClass(ConservationState state) => state switch
    {
        ConservationState.TooHigh => "too-high",
        ConservationState.TooLow => "too-low",
        _ => "ok",
    };

    protected override void OnInitialized()
    {
        _names = _controller.UniverseNames.ToList();
        CreateBatches();
    }

    private void CreateBatches()
    {
        var picture = new CoordinateTransform(DiagramSize, DiagramSize, _controller.DS.MathInterval, _controller.DS.MathInterval);
        _diagram = new DrawBatch(picture);
        _overlay = new DrawBatch(picture);
        _phase = new DrawBatch(new CoordinateTransform(PhaseSize, PhaseSize, _controller.DS.PhaseXInterval, _controller.DS.PhaseYInterval));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas.js");
        await _module.InvokeVoidAsync("setup", "universe-diagram", DiagramSize);
        await _module.InvokeVoidAsync("setup", "universe-overlay", DiagramSize);
        await _module.InvokeVoidAsync("setup", "universe-phase", PhaseSize);
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachPointer", "universe-overlay", _selfReference);
        await RedrawAsync();
    }

    /// <summary>VB: ClearDiagrams, then every star (and its orbit) permanently, the new star temporarily.</summary>
    private async Task RedrawAsync()
    {
        CreateBatches();
        _diagram.Clear();
        _overlay.Clear();
        _phase.Clear();
        foreach (var star in _controller.DS.ActiveStarCollection)
        {
            DrawStarWithOrbit(_diagram, star);
        }

        if (_controller.NewStar is { } newStar)
        {
            DrawStarWithOrbit(_overlay, newStar);
        }

        await FlushAsync();
    }

    private static void DrawStarWithOrbit(DrawBatch batch, StarBase star)
    {
        batch.Point(star.DrawPosition, star.Color, star.Size);
        try
        {
            foreach (var point in star.GetOrbit())
            {
                batch.Point(point, star.Color, 1);
            }
        }
        catch (ArithmeticException)
        {
            // VB stopped with "NegativeSquareRoot"; the orbit is not drawn
        }
    }

    private async Task FlushAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (!_diagram.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "universe-diagram", _diagram.Take());
        }

        if (!_overlay.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "universe-overlay", _overlay.Take());
        }

        if (!_phase.IsEmpty)
        {
            await _module.InvokeVoidAsync("draw", "universe-phase", _phase.Take());
        }
    }

    private async Task RunAsync(Action action)
    {
        _error = null;
        action();
        await RedrawAsync();
    }

    private Task OnUniverseChangedAsync(ChangeEventArgs e) => RunAsync(() => _controller.SelectUniverse(IntValue(e)));
    private Task OnConstellationChangedAsync(ChangeEventArgs e) => RunAsync(() => _controller.SelectConstellation(IntValue(e)));
    private Task TakeOverConstellationAsync() => RunAsync(_controller.TakeOverConstellation);
    private Task OnZoomChangedAsync(ChangeEventArgs e) => RunAsync(() => _controller.SetZoom(e.Value is true));
    private Task OnColorChangedAsync(ChangeEventArgs e) => RunAsync(() => _controller.SetColor(IntValue(e)));
    private Task OnMassChangedAsync(ChangeEventArgs e) => RunAsync(() => _controller.SetMassFromTrackBar(IntValue(e)));
    private Task OnVelocityChangedAsync(ChangeEventArgs e) => RunAsync(() => _controller.SetVelocityFromTrackBar(IntValue(e)));
    private Task NewStarAsync() => RunAsync(_controller.NewStarOrCancel);
    private Task ResetAsync() => RunAsync(_controller.ResetIteration);
    private Task DefaultAsync() => RunAsync(_controller.DefaultUserData);
    private Task ClearUniverseAsync() => RunAsync(_controller.ClearUniverse);

    private async Task SaveStarAsync()
    {
        _error = _controller.SaveStar();
        await RedrawAsync();
    }

    private async Task StartAsync()
    {
        var isNewStart = _controller.Status == IterationStatus.Stopped;
        _error = _controller.Start();
        if (_error is not null)
        {
            if (_controller.IsResetByStart)
            {
                await RedrawAsync();
            }

            return;
        }

        if (isNewStart)
        {
            // VB: ClearDiagrams at the start
            CreateBatches();
            _diagram.Clear();
            _phase.Clear();
        }

        var watch = new System.Diagnostics.Stopwatch();
        _pacer.Restart();
        while (_controller.Status == IterationStatus.Running && !_disposed)
        {
            var loops = _pacer.NextSteps(LoopsPerSecond[_speedIndex]);
            watch.Restart();
            for (var i = 0; i < loops && watch.Elapsed.TotalMilliseconds < FrameBudgetMs; i++)
            {
                var step = _controller.Step();
                foreach (var (from, to, color) in step.Tracks)
                {
                    _diagram.Line(from, to, color, 2);
                }

                foreach (var (point, color) in step.PhasePoints)
                {
                    _phase.Point(point, color, 1);
                }
            }

            // the actual positions of the stars (VB: DrawStar(False), the picture box is refreshed every 5 loops)
            _overlay.Clear();
            foreach (var star in _controller.DS.ActiveStarCollection)
            {
                _overlay.Point(star.DrawPosition, star.Color, star.Size);
            }

            await FlushAsync();
            StateHasChanged();
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");
            }
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPointer(string kind, double x, double y)
    {
        var position = _overlay.Transform.PixelToMathPoint((int)Math.Round(x), (int)Math.Round(y));
        switch (kind)
        {
            case "down":
            case "move":
                var changed = kind == "down" ? _controller.MouseDown(position) : _controller.MouseMove(position);
                if (changed && _controller.NewStar is { } star)
                {
                    // VB: the new star and its orbit temporarily
                    _overlay.Clear();
                    DrawStarWithOrbit(_overlay, star);
                    await FlushAsync();
                    StateHasChanged();
                }
                break;
            default:
                if (_controller.MouseUp())
                {
                    await RedrawAsync();
                    StateHasChanged();
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _controller.Stop();
        _selfReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
