@inherits LayoutComponentBase
@using System.Globalization
@using Dynamics.Core.General
@inject IJSRuntime JS
@inject NavigationManager Navigation

<header class="top-bar">
    <a class="brand" href="">Dynamics</a>
    <nav>
        <NavLink href="population">@Nav("MnuPopulationDensity")</NavLink>
        <NavLink href="iteration">@Text.Get("GrowthModels")</NavLink>
        <NavLink href="sensitivity">@Nav("MnuSensitivity")</NavLink>
        <NavLink href="histogram">@Nav("MnuHistogram")</NavLink>
        <NavLink href="twodimensions">@Nav("MnuTwoDimensions")</NavLink>
        <NavLink href="feigenbaum">@Nav("MnuFeigenbaum")</NavLink>
        <NavLink href="pendulum">@Text.Get("Pendulum")</NavLink>
        <NavLink href="numericmethods">@Text.Get("MnuNumericMethods")</NavLink>
        <NavLink href="julia">@Text.Get("JuliaMandelbrot")</NavLink>
        <NavLink href="mandelbrotmap">@Text.Get("MnuMandelbrotMap")</NavLink>
        <NavLink href="newton">@Text.Get("NewtonIteration")</NavLink>
        <NavLink href="singlenewton">@Text.Get("SingleNewtonIteration")</NavLink>
        <NavLink href="strangeattractor">@Text.Get("MnuStrangeAttractors")</NavLink>
        <NavLink href="bifurcation">@Text.Get("MnuBifurcation")</NavLink>
        <NavLink href="billiard">@Text.Get("Billiard")</NavLink>
        <NavLink href="cdiagram">@Text.Get("C-Diagram")</NavLink>
        <NavLink href="universe">@Text.Get("MnuUniverse")</NavLink>
    </nav>
    <div class="language" role="group" aria-label="Language">
        <button type="button" class="@(IsGerman ? "active" : "")" @onclick='() => SetLanguageAsync("de-CH")'>DE</button>
        <button type="button" class="@(IsGerman ? "" : "active")" @onclick='() => SetLanguageAsync("en-US")'>EN</button>
    </div>
</header>

<main>
    @Body
</main>

@code {
    /// <summary>Menu texts of VB contain the &amp; of the access key.</summary>
    private static string Nav(string key) => Text.Get(key).Replace("&", "");

    private static bool IsGerman => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "de";

    /// <summary>The culture is set at startup (Program.cs), so changing it reloads the app.</summary>
    private async Task SetLanguageAsync(string culture)
    {
        if (CultureInfo.CurrentUICulture.Name == culture)
        {
            return;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", "dynamics.culture", culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
